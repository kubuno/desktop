      "size": [200, 100],
      "resize": [300, 160],
      "children": [{ "name": "a", "rect": [10, 10, 80, 30], "anchor": "Top,Bottom" }]
    },
    {
      "id": "A09-anchor-top-only",
      "why": "Top alone: pinned vertically, unanchored horizontally.",
      "size": [200, 100],
      "resize": [300, 160],
      "children": [{ "name": "a", "rect": [10, 10, 80, 30], "anchor": "Top" }]
    },
