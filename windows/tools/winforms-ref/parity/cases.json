      "why": "Bottom only: moves vertically, keeps its height.",
      "size": [200, 100],
      "resize": [300, 160],
      "children": [{ "name": "a", "rect": [10, 10, 80, 30], "anchor": "Bottom,Left" }]
    },
    {
      "id": "A04-anchor-bottom-right",
      "why": "Both far edges: moves on both axes.",
      "size": [200, 100],
      "resize": [300, 160],
      "children": [{ "name": "a", "rect": [10, 10, 80, 30], "anchor": "Bottom,Right" }]
    },
    {
      "id": "A05-anchor-all-four",
      "why": "Anchored to all four edges: stretches on both axes.",
      "size": [200, 100],
      "resize": [300, 160],
      "children": [
        { "name": "a", "rect": [10, 10, 80, 30], "anchor": "Top,Bottom,Left,Right" }
      ]
    },
    {
      "id": "A06-anchor-none",
      "why": "AnchorStyles.None. WinForms keeps a None-anchored child PROPORTIONALLY placed (it moves by half the size change); does the port?",
      "size": [200, 100],
      "resize": [300, 160],
      "children": [{ "name": "a", "rect": [10, 10, 80, 30], "anchor": "None" }]
    },
    {
      "id": "A07-anchor-left-right",
      "why": "Horizontal stretch, vertically unanchored (the half-delta case on the Y axis).",
      "size": [200, 100],
      "resize": [300, 160],
      "children": [{ "name": "a", "rect": [10, 10, 80, 30], "anchor": "Left,Right" }]
    },
