    {
      "id": "A20-odd-start-half-delta",
      "why": "An ODD start size on the unanchored axis. WinForms recentres on displayRect.Width / 2 (integer), which is NOT the same number as adding half the size CHANGE — this case is the one that tells the two rules apart.",
      "size": [201, 101],
      "resize": [300, 160],
      "children": [{ "name": "a", "rect": [10, 10, 80, 30], "anchor": "None" }]
    },

    {
