{
  "//": "SHARED case list for the layout parity harness. Read at RUNTIME by both",
  "//1": "probes: tools/winforms-ref/parity/layout-winforms (real WinForms) and",
  "//2": "crates/kubuno-controls/examples/parity_layout.rs (the port). Neither owns",
  "//3": "a copy, so the two can never silently drift apart in what they test.",
  "//4": "",
  "//5": "Units are DIP == pixels: the C# probe runs DpiUnaware and the port never",
  "//6": "scales, so both sides do their arithmetic in the same space and a delta",
  "//7": "is a real difference in the model, not a scaling artefact.",
  "//8": "",
  "//9": "Child defaults mirror the toolkit's own: dock None, anchor Top|Left,",
  "//10": "visible true, margin 3 on all sides (Control.DefaultMargin), padding 0,",
  "//11": "min/max empty (== no constraint). rect is [x, y, w, h].",
  "//12": "",
  "//13": "Property order is fixed on BOTH sides: min/max FIRST, then rect, then",
  "//14": "dock/anchor. WinForms' MinimumSize setter clamps the bounds immediately,",
  "//15": "so setting them the other way round would compare two different inputs.",
  "//16": "",
  "//17": "A nested container's rect carries a REALISTIC design size — the size the",
  "//18": "first dock pass will give it — even though a docked node's own rect is",
  "//19": "otherwise ignored on the axis it docks to. It is the baseline its own",
  "//20": "anchored children are measured from, so a placeholder like [0,0,10,10]",
  "//21": "would make every nested anchor case measure that placeholder instead.",

  "cases": [
    {
      "id": "D01-dock-top",
      "why": "One Top band: full width, its own height.",
      "size": [200, 100],
      "children": [{ "name": "a", "rect": [0, 0, 50, 24], "dock": "Top" }]
    },
    {
      "id": "D02-dock-bottom",
      "why": "One Bottom band.",
      "size": [200, 100],
      "children": [{ "name": "a", "rect": [0, 0, 50, 20], "dock": "Bottom" }]
    },
    {
      "id": "D03-dock-left",
      "why": "One Left band: full height, its own width.",
      "size": [200, 100],
      "children": [{ "name": "a", "rect": [0, 0, 60, 10], "dock": "Left" }]
    },
    {
      "id": "D04-dock-right",
      "why": "One Right band.",
      "size": [200, 100],
      "children": [{ "name": "a", "rect": [0, 0, 40, 10], "dock": "Right" }]
    },
    {
      "id": "D05-dock-fill",
      "why": "Fill alone takes the whole display rect and forgets its design bounds.",
      "size": [200, 100],
      "children": [{ "name": "a", "rect": [5, 5, 50, 24], "dock": "Fill" }]
    },
    {
      "id": "D06-dock-four-edges-then-fill",
      "why": "The canonical four bands plus Fill, added in edge-then-fill order.",
      "size": [300, 200],
      "children": [
        { "name": "top", "rect": [0, 0, 10, 30], "dock": "Top" },
        { "name": "bottom", "rect": [0, 0, 10, 20], "dock": "Bottom" },
        { "name": "left", "rect": [0, 0, 60, 10], "dock": "Left" },
        { "name": "right", "rect": [0, 0, 40, 10], "dock": "Right" },
        { "name": "fill", "rect": [0, 0, 10, 10], "dock": "Fill" }
      ]
    },
    {
      "id": "D07-dock-two-tops",
      "why": "Reverse z-order: the child added LAST gets the outermost band.",
      "size": [200, 100],
      "children": [
        { "name": "inner", "rect": [0, 0, 10, 30], "dock": "Top" },
        { "name": "outer", "rect": [0, 0, 10, 20], "dock": "Top" }
      ]
    },
    {
      "id": "D08-fill-first-in-z-order",
      "why": "Fill added FIRST, so it is resolved LAST in the reverse walk. Does Fill get the leftover, or the whole rect with the Top band drawn over it?",
      "size": [200, 100],
      "children": [
        { "name": "fill", "rect": [0, 0, 10, 10], "dock": "Fill" },
        { "name": "top", "rect": [0, 0, 10, 30], "dock": "Top" }
      ]
    },
    {
      "id": "D09-fill-last-in-z-order",
      "why": "The mirror of D08: Fill added last, resolved first.",
      "size": [200, 100],
      "children": [
        { "name": "top", "rect": [0, 0, 10, 30], "dock": "Top" },
        { "name": "fill", "rect": [0, 0, 10, 10], "dock": "Fill" }
      ]
    },
    {
      "id": "D10-fill-between-two-bands",
      "why": "Fill sandwiched in z-order between a Top and a Bottom.",
      "size": [200, 100],
      "children": [
        { "name": "top", "rect": [0, 0, 10, 30], "dock": "Top" },
        { "name": "fill", "rect": [0, 0, 10, 10], "dock": "Fill" },
        { "name": "bottom", "rect": [0, 0, 10, 20], "dock": "Bottom" }
      ]
    },
    {
      "id": "D11-two-fills",
      "why": "Two Fill siblings. Both full-size, or only one?",
      "size": [200, 100],
      "children": [
        { "name": "f1", "rect": [0, 0, 10, 10], "dock": "Fill" },
        { "name": "f2", "rect": [0, 0, 10, 10], "dock": "Fill" }
      ]
    },
    {
      "id": "D12-oversize-top",
      "why": "A Top band taller than the container. Clamped to the remaining space, or allowed to overflow?",
      "size": [200, 100],
      "children": [{ "name": "a", "rect": [0, 0, 10, 400], "dock": "Top" }]
    },
    {
      "id": "D13-oversize-left",
      "why": "The horizontal mirror of D12.",
      "size": [200, 100],
      "children": [{ "name": "a", "rect": [0, 0, 500, 10], "dock": "Left" }]
    },
    {
      "id": "D14-three-tops-exhaust",
      "why": "Three 50-tall Top bands in a 100-tall container: the third has no room left.",
      "size": [200, 100],
      "children": [
        { "name": "a", "rect": [0, 0, 10, 50], "dock": "Top" },
        { "name": "b", "rect": [0, 0, 10, 50], "dock": "Top" },
        { "name": "c", "rect": [0, 0, 10, 50], "dock": "Top" }
      ]
    },
    {
      "id": "D15-hidden-band-then-fill",
      "why": "A hidden Top band must consume no edge, and must keep its own bounds.",
      "size": [200, 100],
      "children": [
        { "name": "hidden", "rect": [7, 9, 40, 40], "dock": "Top", "visible": false },
        { "name": "fill", "rect": [0, 0, 10, 10], "dock": "Fill" }
      ]
    },
    {
      "id": "D16-container-padding",
      "why": "Container Padding shifts the display rect. Tests the origin convention as much as the size.",
      "size": [200, 100],
      "padding": [10, 10, 10, 10],
      "children": [
        { "name": "top", "rect": [0, 0, 10, 24], "dock": "Top" },
        { "name": "fill", "rect": [0, 0, 10, 10], "dock": "Fill" }
      ]
    },
    {
      "id": "D17-child-margin",
      "why": "Does DefaultLayout's dock pass honour a child's Margin? The port's Item carries no margin at all.",
      "size": [200, 100],
      "children": [
        { "name": "top", "rect": [0, 0, 10, 24], "dock": "Top", "margin": [8, 8, 8, 8] },
        { "name": "fill", "rect": [0, 0, 10, 10], "dock": "Fill", "margin": [8, 8, 8, 8] }
      ]
    },
    {
      "id": "D18-docked-min-height",
      "why": "A Top band shorter than its MinimumSize. The band must grow, and the leftover must shrink with it.",
      "size": [200, 100],
      "children": [
        { "name": "top", "rect": [0, 0, 10, 10], "dock": "Top", "min": [0, 40] },
        { "name": "fill", "rect": [0, 0, 10, 10], "dock": "Fill" }
      ]
    },
    {
      "id": "D19-docked-max-height",
      "why": "A Top band taller than its MaximumSize.",
      "size": [200, 100],
      "children": [
        { "name": "top", "rect": [0, 0, 10, 90], "dock": "Top", "max": [0, 30] },
        { "name": "fill", "rect": [0, 0, 10, 10], "dock": "Fill" }
      ]
    },
    {
      "id": "D20-fill-max-size",
      "why": "MaximumSize on the Fill child: does the leftover rect get clamped?",
      "size": [200, 100],
      "children": [
        { "name": "fill", "rect": [0, 0, 10, 10], "dock": "Fill", "max": [120, 60] }
      ]
    },
    {
      "id": "D21-right-left-fill",
      "why": "Right and Left added before Fill, so the vertical bands resolve outside-in.",
      "size": [300, 150],
      "children": [
        { "name": "right", "rect": [0, 0, 40, 10], "dock": "Right" },
        { "name": "left", "rect": [0, 0, 60, 10], "dock": "Left" },
        { "name": "fill", "rect": [0, 0, 10, 10], "dock": "Fill" }
      ]
    },
    {
      "id": "D22-mixed-z-order",
      "why": "Fill first, then three edges: every band resolves before the Fill in the reverse walk.",
      "size": [300, 200],
      "children": [
        { "name": "fill", "rect": [0, 0, 10, 10], "dock": "Fill" },
        { "name": "left", "rect": [0, 0, 50, 10], "dock": "Left" },
        { "name": "top", "rect": [0, 0, 10, 25], "dock": "Top" },
        { "name": "right", "rect": [0, 0, 30, 10], "dock": "Right" }
      ]
    },

    {
      "id": "D23-padding-dock-and-anchor",
      "why": "A padded container holding BOTH a docked band and an anchored child. Nothing resizes, so any delta is purely a disagreement about which origin a child's rectangle is measured from — and the two children must agree with each other.",
      "size": [200, 100],
      "padding": [10, 10, 10, 10],
      "children": [
        { "name": "band", "rect": [0, 0, 10, 24], "dock": "Top" },
        { "name": "free", "rect": [10, 40, 80, 30], "anchor": "Top,Left" }
      ]
    },
    {
      "id": "D24-band-cross-axis-max",
      "why": "MaximumSize on the axis the dock pass COMPUTES (a Left band's height) rather than the one it copies from the design size. Design-time clamping cannot mask this one.",
      "size": [200, 120],
      "children": [
        { "name": "left", "rect": [0, 0, 60, 10], "dock": "Left", "max": [0, 50] },
        { "name": "top", "rect": [0, 0, 10, 20], "dock": "Top", "max": [90, 0] }
      ]
    },

    {
      "id": "A01-anchor-top-left",
      "why": "The default anchor: the child must not move when the container grows.",
