<!--
  The open conversation (the web's ConversationView): the header (avatar, name, status coloured by
  presence, search / details / more), the MessageThread, and the composer (an auto-growing TextArea:
  Enter sends, Shift+Enter makes a new line). With no conversation open, an EmptyState instead.
  The window fills it through typed access (ConversationPane::show) and handles its events.
-->
<UserControl xmlns="https://kubuno.com/views" xmlns:x="https://kubuno.com/views/x" x:Class="ConversationPane" DesignWidth="764" DesignHeight="768" BackColor="Background" AcceptButton="send">
  <Panel x:Name="header" Dock="Top" Height="60" BackColor="TitleBarBackground" Visible="{Binding HasConversation}">
    <Avatar x:Name="avatar" DisplayName="{Binding Title}" Initials="{Binding Initial}" Shape="{Binding AvatarShape}" Presence="{Binding Presence}" AvatarSize="38" X="12" Y="11" Width="38" Height="38"/>
    <Label x:Name="title" Text="{Binding Title}" Font="style=Bold" TextAlign="MiddleLeft" Visible="{Binding NotSearching}" X="62" Y="11" Width="556" Height="22" Anchor="Top, Left, Right"/>
    <Label x:Name="status" Text="{Binding Status}" Role="Meta" ForeColor="{Binding StatusColor}" TextAlign="MiddleLeft" Visible="{Binding NotSearching}" X="62" Y="32" Width="556" Height="18" Anchor="Top, Left, Right"/>
    <SearchField x:Name="thread_search" Text="{Binding SearchText, Mode=TwoWay}" Placeholder="{Res thread_search_placeholder}" Visible="{Binding Searching}" OnTextChanged="thread_search_text_changed" X="62" Y="12" Width="556" Height="36" Anchor="Top, Left, Right"/>
    <IconButton x:Name="search_button" Icon="Search" Diameter="36" Glyph="18" ToolTip="{Res search_in_conversation_tip}" OnClick="search_button_click" X="632" Y="12" Width="36" Height="36" Anchor="Top, Right"/>
    <IconButton x:Name="info_button" Icon="Info" Diameter="36" Glyph="18" ToolTip="{Res info_tip}" DropDownMenu="info_menu" X="672" Y="12" Width="36" Height="36" Anchor="Top, Right"/>
    <IconButton x:Name="more_button" Icon="MoreVertical" Diameter="36" Glyph="18" ToolTip="{Res more_tip}" DropDownMenu="more_menu" X="712" Y="12" Width="36" Height="36" Anchor="Top, Right"/>
    <Panel x:Name="header_rule" Dock="Bottom" Height="1" BackColor="Divider"/>
  </Panel>
  <Stack x:Name="composer" Dock="Bottom" Direction="LeftToRight" CrossAlign="Center" Gap="6" Padding="12" MinimumSize="0, 72" AutoSize="true" Visible="{Binding HasConversation}">
    <TextArea x:Name="draft" Text="{Binding Draft, Mode=TwoWay}" Placeholder="{Res composer_placeholder}" AcceptsReturn="false" MinLines="1" MaxLines="6" Stack.Fill="true"/>
    <!-- Attaching a file: no upload in the chat API yet (api.rs), so the paperclip is left out until there is (a
         Visible="false" child still takes its place in a Stack):
    <IconButton x:Name="attach" Icon="Paperclip" Diameter="36" Glyph="18" ToolTip="{Res attach_tip}" Width="36" Height="36"/> -->
    <IconButton x:Name="send" Icon="Send" Filled="true" Diameter="44" Glyph="20" ToolTip="{Res send_tip}" OnClick="send_click" Width="44" Height="44"/>
  </Stack>
  <MessageThread x:Name="thread" Messages="{Binding Thread}" Dock="Fill" Visible="{Binding HasConversation}" OnMessageActivated="thread_message_activated" OnReachedTop="thread_reached_top"/>
  <EmptyState x:Name="empty" Icon="MessagesSquare" Title="{Res empty_title}" Description="{Res empty_description}" Dock="Fill" Visible="{Binding NoConversation}"/>
  <ContextMenu x:Name="info_menu">
    <MenuItem Kind="Header" Text="{Binding KindText}"/>
    <MenuItem x:Name="copy_link" Text="{Res copy_link}" Icon="Link" Enabled="{Binding HasServerId}" OnClick="copy_link_click"/>
    <MenuItem x:Name="copy_id" Text="{Res copy_id}" Icon="Copy" Enabled="{Binding HasServerId}" OnClick="copy_id_click"/>
  </ContextMenu>
  <ContextMenu x:Name="more_menu">
    <MenuItem x:Name="search_item" Text="{Res search_in_conversation}" Icon="Search" ShortcutKeys="Ctrl+F" OnClick="search_button_click"/>
    <MenuItem x:Name="mark_read" Text="{Res mark_read}" Icon="CheckCheck" OnClick="mark_read_click"/>
    <MenuItem Kind="Separator"/>
    <MenuItem x:Name="close_item" Text="{Res close_conversation}" Icon="X" OnClick="close_click"/>
  </ContextMenu>
</UserControl>
