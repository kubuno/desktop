<!--
  The conversation list (the web's HomeList): the heading, the search field, and the conversations as a
  Repeater of ConversationRow. The window fills Rows and SelectedIndex (typed access, ChatWindow::refresh)
  and handles ConversationSelected / SearchChanged.
-->
<UserControl xmlns="https://kubuno.com/views" xmlns:x="https://kubuno.com/views/x" x:Class="ConversationListPane" DesignWidth="360" DesignHeight="768" BackColor="Surface">
  <Label x:Name="title" Text="{Binding Title}" Role="Title" TextAlign="MiddleLeft" X="12" Y="0" Width="292" Height="60" Anchor="Top, Left, Right"/>
  <!-- Creating a conversation is not in the chat API yet (api.rs): hidden until it is. -->
  <IconButton x:Name="new_message" Icon="PenLine" Filled="true" Diameter="36" Glyph="18" ToolTip="{Res new_message_tip}" Visible="false" X="312" Y="12" Width="36" Height="36" Anchor="Top, Right"/>
  <SearchField x:Name="search" Text="{Binding Filter, Mode=TwoWay}" Placeholder="{Res search_placeholder}" OnTextChanged="search_text_changed" X="12" Y="68" Width="336" Height="36" Anchor="Top, Left, Right"/>
  <Repeater x:Name="list" ItemsSource="{Binding Rows}" ItemTemplate="ConversationRow" ItemKey="Key" ItemHeight="66" Spacing="6" SelectionMode="Single" SelectedIndex="{Binding SelectedIndex, Mode=TwoWay}" EmptyText="{Binding EmptyText}" DesignItemCount="4" OnItemClick="list_item_click" X="6" Y="115" Width="348" Height="653" Anchor="Top, Bottom, Left, Right"/>
  <Panel x:Name="seam" BackColor="Divider" X="359" Y="0" Width="1" Height="768" Anchor="Top, Bottom, Right"/>
</UserControl>
