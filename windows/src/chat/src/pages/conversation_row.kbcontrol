<!--
  One conversation of the list: the item template of the list's Repeater (ItemTemplate="ConversationRow").
  Its bindings read the fields of the item's row (view_model::conversation_row): the avatar, the name and
  time on the first line, the last message and the unread badge on the second. The selection and hover
  pills are the Repeater's, under the item.
-->
<UserControl xmlns="https://kubuno.com/views" xmlns:x="https://kubuno.com/views/x" x:Class="ConversationRow" DesignWidth="348" DesignHeight="66">
  <Avatar x:Name="avatar" DisplayName="{Binding Name}" Initials="{Binding Initial}" Shape="{Binding AvatarShape}" Presence="{Binding Presence}" AvatarSize="46" X="8" Y="10" Width="46" Height="46"/>
  <Label x:Name="name" Text="{Binding Name}" Font="{Binding NameFont}" TextAlign="MiddleLeft" X="66" Y="12" Width="228" Height="22" Anchor="Top, Left, Right"/>
  <Label x:Name="time" Text="{Binding Time}" Role="Meta" ForeColor="{Binding TimeColor}" TextAlign="MiddleLeft" X="294" Y="13" Width="48" Height="18" Anchor="Top, Right"/>
  <Label x:Name="snippet" Text="{Binding Snippet}" Role="Meta" ForeColor="{Binding SnippetColor}" TextAlign="MiddleLeft" X="66" Y="34" Width="244" Height="22" Anchor="Top, Left, Right"/>
  <Badge x:Name="unread" Text="{Binding Unread}" Variant="Primary" Visible="{Binding HasUnread}" X="318" Y="35" Width="24" Height="22" Anchor="Top, Right"/>
</UserControl>
