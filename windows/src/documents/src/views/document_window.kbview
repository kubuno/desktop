  <Command x:Name="cmd_tt_dedupe" Label="{Res cmd_tt_dedupe}"/>
  <Command x:Name="cmd_tt_title" Label="{Res cmd_tt_title}"/>
  <Command x:Name="cmd_tt_clear" Label="{Res cmd_tt_clear}"/>
  <Command x:Name="cmd_details" Label="{Res cmd_details}" SmallIcon="FileText"/>
  <Command x:Name="cmd_cover" Label="{Res cmd_cover}" SmallIcon="FileText"/>
  <Command x:Name="cmd_cover1" Label="{Res cmd_cover1}"/>
  <Command x:Name="cmd_cover2" Label="{Res cmd_cover2}"/>
  <Command x:Name="cmd_pb" Label="{Res cmd_pb}" SmallIcon="SeparatorHorizontal" OnExecute="pb_execute" Shortcut="Ctrl+Enter"/>
