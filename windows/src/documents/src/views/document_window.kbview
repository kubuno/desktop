  <Command x:Name="cmd_shade_none" Label="{Res cmd_shade_none}"/>
  <Command x:Name="cmd_shade_grey" Label="{Res cmd_shade_grey}"/>
  <Command x:Name="cmd_border_box" Label="{Res cmd_border_box}"/>
  <Command x:Name="cmd_border_none" Label="{Res cmd_border_none}"/>
  <Command x:Name="cmd_flow_widow" Label="{Res cmd_flow_widow}"/>
  <Command x:Name="cmd_flow_keepnext" Label="{Res cmd_flow_keepnext}" IsCheckable="true" Checked="{Binding KeepNext}" OnExecute="flow_keepnext_execute"/>
  <Command x:Name="cmd_flow_keeplines" Label="{Res cmd_flow_keeplines}" IsCheckable="true" Checked="{Binding KeepLines}" OnExecute="flow_keeplines_execute"/>
  <Command x:Name="cmd_flow_pagebreak" Label="{Res cmd_flow_pagebreak}" IsCheckable="true" Checked="{Binding PageBreakBefore}" OnExecute="flow_pagebreak_execute"/>
  <Command x:Name="cmd_link" Label="{Res cmd_link}" SmallIcon="Link" IsCheckable="true" Checked="{Binding OnLink}" OnExecute="link_execute" Shortcut="Ctrl+K"/>
  <Command x:Name="cmd_link_web" Label="{Res cmd_link_web}" OnExecute="link_execute"/>
  <Command x:Name="cmd_link_mail" Label="{Res cmd_link_mail}"/>
  <Command x:Name="cmd_link_rm" Label="{Res cmd_link_rm}" OnExecute="link_rm_execute"/>
  <Command x:Name="cmd_bookmark" Label="{Res cmd_bookmark}" SmallIcon="Bookmark"/>
  <Command x:Name="cmd_goto" Label="{Res cmd_goto}" SmallIcon="CornerDownRight"/>
  <Command x:Name="cmd_wordcount" Label="{Res cmd_wordcount}" SmallIcon="Hash" OnExecute="wordcount_execute"/>
