  <Command x:Name="cmd_table_insert" Label="{Res cmd_table_insert}" OnExecute="table_insert_execute"/>
  <Command x:Name="cmd_table_from_text" Label="{Res cmd_table_from_text}"/>
  <Command x:Name="cmd_txt2tbl" Label="{Res cmd_txt2tbl}" SmallIcon="Table"/>
  <Command x:Name="cmd_tbl2txt" Label="{Res cmd_tbl2txt}" SmallIcon="WrapText"/>
  <Command x:Name="cmd_img" Label="{Res cmd_img}" SmallIcon="Image" OnExecute="img_execute"/>
  <Command x:Name="cmd_shape_rect" Label="{Res cmd_shape_rect}"/>
  <Command x:Name="cmd_shape_ellipse" Label="{Res cmd_shape_ellipse}"/>
  <Command x:Name="cmd_shape_line" Label="{Res cmd_shape_line}"/>
  <Command x:Name="cmd_shape_arrow" Label="{Res cmd_shape_arrow}"/>
