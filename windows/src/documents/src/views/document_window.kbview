<!--
  Kubuno Documents' window, laid out like Word: the ribbon (its tab strip colours the title bar), the
  rulers around the page, the paginated document and the status bar with the zoom slider.
  DocumentWindow (document_window.rs) opens the document into the page canvas, binds what the canvas
  reports to the rulers, the status bar and the Backstage, and applies what the rulers change.
  Every ribbon command is a <Command>: those the desktop can run today (the ruler, the zoom) have a
  handler; the others are declared, enabled as on the web, and have no effect until the editing path
  exists — never a fake one.
-->
<Panel xmlns="https://kubuno.com/views" xmlns:x="https://kubuno.com/views/x" DesignWidth="1280" DesignHeight="860" Title="{Binding WindowTitle}" Icon="{Res app_icon}" ShowIcon="false"
       ShowWaffle="true" ShowAccount="true"
       OnLoad="document_window_load" OnFormClosing="document_window_closing">
  <Command x:Name="cmd_save" Label="{Res cmd_save}" SmallIcon="Save" Shortcut="Ctrl+S" Enabled="{Binding CanSave}" OnExecute="save_execute"/>
  <Command x:Name="cmd_undo" Label="{Res cmd_undo}" SmallIcon="Undo2" Shortcut="Ctrl+Z" Enabled="{Binding CanUndo}" OnExecute="undo_execute"/>
  <Command x:Name="cmd_redo" Label="{Res cmd_redo}" SmallIcon="Redo2" Shortcut="Ctrl+Y" Enabled="{Binding CanRedo}" OnExecute="redo_execute"/>
  <!-- The commands (component tray): one per ribbon action, shared by the ribbon, the quick access toolbar and the shortcuts. -->
  <Command x:Name="cmd_paste" Label="{Res cmd_paste}" SmallIcon="ClipboardPaste" Shortcut="Ctrl+V" OnExecute="paste_execute"/>
  <Command x:Name="cmd_cut" Label="{Res cmd_cut}" SmallIcon="Scissors" Shortcut="Ctrl+X" OnExecute="cut_execute"/>
  <Command x:Name="cmd_copy" Label="{Res cmd_copy}" SmallIcon="Copy" Shortcut="Ctrl+C" OnExecute="copy_execute"/>
  <Command x:Name="cmd_paste_plain" Label="{Res cmd_paste_plain}" SmallIcon="ClipboardPaste" OnExecute="paste_plain_execute"/>
  <Command x:Name="cmd_select_all" Label="{Res cmd_select_all}" SmallIcon="SelectAll" OnExecute="select_all_execute"/>
  <Command x:Name="cmd_find" Label="{Res cmd_find}" SmallIcon="Search" Shortcut="Ctrl+F" OnExecute="find_execute"/>
  <Command x:Name="cmd_replace" Label="{Res cmd_replace}" SmallIcon="Replace" Shortcut="Ctrl+H" OnExecute="replace_execute"/>
  <Command x:Name="cmd_cliphist" Label="{Res cmd_cliphist}" SmallIcon="ClipboardList" ScreenTipTitle="{Res cmd_cliphist_tip}"/>
  <Command x:Name="cmd_fmtpainter" Label="{Res cmd_fmtpainter}" SmallIcon="Paintbrush" Shortcut="Alt+Ctrl+C" ScreenTipTitle="{Res cmd_fmtpainter_tip}" IsCheckable="true" Checked="{Binding FormatPainter}" OnExecute="fmtpainter_execute"/>
  <Command x:Name="cmd_clear" Label="{Res cmd_clear}" SmallIcon="Eraser" OnExecute="clear_execute"/>
  <Command x:Name="cmd_bold" Label="{Res cmd_bold}" SmallIcon="Bold" Shortcut="Ctrl+B" IsCheckable="true" Checked="{Binding Bold}" OnExecute="bold_execute"/>
  <Command x:Name="cmd_italic" Label="{Res cmd_italic}" SmallIcon="Italic" Shortcut="Ctrl+I" IsCheckable="true" Checked="{Binding Italic}" OnExecute="italic_execute"/>
  <Command x:Name="cmd_underline" Label="{Res cmd_underline}" SmallIcon="Underline" Shortcut="Ctrl+U" IsCheckable="true" Checked="{Binding Underline}" OnExecute="underline_execute"/>
  <Command x:Name="cmd_strike" Label="{Res cmd_strike}" SmallIcon="Strikethrough" IsCheckable="true" Checked="{Binding Strike}" OnExecute="strike_execute" Shortcut="Ctrl+Shift+S"/>
  <Command x:Name="cmd_subscript" Label="{Res cmd_subscript}" SmallIcon="Subscript" IsCheckable="true" Checked="{Binding Subscript}" OnExecute="subscript_execute"/>
  <Command x:Name="cmd_superscript" Label="{Res cmd_superscript}" SmallIcon="Superscript" IsCheckable="true" Checked="{Binding Superscript}" OnExecute="superscript_execute"/>
  <Command x:Name="cmd_grow" Label="{Res cmd_grow}" SmallIcon="AArrowUp" OnExecute="grow_execute"/>
  <Command x:Name="cmd_shrink" Label="{Res cmd_shrink}" SmallIcon="AArrowDown" OnExecute="shrink_execute"/>
  <Command x:Name="cmd_case_upper" Label="{Res cmd_case_upper}" OnExecute="case_upper_execute"/>
  <Command x:Name="cmd_case_lower" Label="{Res cmd_case_lower}" OnExecute="case_lower_execute"/>
  <Command x:Name="cmd_case_title" Label="{Res cmd_case_title}" OnExecute="case_title_execute"/>
  <Command x:Name="cmd_case_sentence" Label="{Res cmd_case_sentence}" OnExecute="case_sentence_execute"/>
  <Command x:Name="cmd_case_toggle" Label="{Res cmd_case_toggle}" OnExecute="case_toggle_execute"/>
  <Command x:Name="cmd_case_smallcaps" Label="{Res cmd_case_smallcaps}" OnExecute="case_smallcaps_execute"/>
  <Command x:Name="cmd_case_spacing" Label="{Res cmd_case_spacing}"/>
  <Command x:Name="cmd_color" Label="{Res cmd_color}" SmallIcon="Baseline" OnExecute="color_execute"/>
  <Command x:Name="cmd_color_auto" Label="{Res cmd_color_auto}" OnExecute="color_auto_execute"/>
  <Command x:Name="cmd_color_red" Label="{Res cmd_color_red}" OnExecute="color_red_execute"/>
  <Command x:Name="cmd_color_blue" Label="{Res cmd_color_blue}" OnExecute="color_blue_execute"/>
  <Command x:Name="cmd_color_more" Label="{Res cmd_color_more}"/>
  <Command x:Name="cmd_highlight" Label="{Res cmd_highlight}" SmallIcon="Highlighter" OnExecute="highlight_execute"/>
  <Command x:Name="cmd_hl_yellow" Label="{Res cmd_hl_yellow}" OnExecute="hl_yellow_execute"/>
  <Command x:Name="cmd_hl_green" Label="{Res cmd_hl_green}" OnExecute="hl_green_execute"/>
  <Command x:Name="cmd_hl_cyan" Label="{Res cmd_hl_cyan}" OnExecute="hl_cyan_execute"/>
  <Command x:Name="cmd_hl_none" Label="{Res cmd_hl_none}" OnExecute="hl_none_execute"/>
  <Command x:Name="cmd_ul" Label="{Res cmd_ul}" SmallIcon="List" IsCheckable="true" Checked="{Binding ListBullet}" OnExecute="ul_execute" Shortcut="Ctrl+Shift+8"/>
  <Command x:Name="cmd_ol" Label="{Res cmd_ol}" SmallIcon="ListOrdered" IsCheckable="true" Checked="{Binding ListOrdered}" OnExecute="ol_execute" Shortcut="Ctrl+Shift+7"/>
  <Command x:Name="cmd_task" Label="{Res cmd_task}" SmallIcon="SquareCheck" IsCheckable="true" Checked="{Binding ListTask}" OnExecute="task_execute"/>
  <Command x:Name="cmd_al_left" Label="{Res cmd_al_left}" SmallIcon="AlignLeft" IsCheckable="true" Checked="{Binding AlignLeft}" OnExecute="al_left_execute" Shortcut="Ctrl+L"/>
  <Command x:Name="cmd_al_center" Label="{Res cmd_al_center}" SmallIcon="AlignCenter" IsCheckable="true" Checked="{Binding AlignCenter}" OnExecute="al_center_execute" Shortcut="Ctrl+E"/>
  <Command x:Name="cmd_al_right" Label="{Res cmd_al_right}" SmallIcon="AlignRight" IsCheckable="true" Checked="{Binding AlignRight}" OnExecute="al_right_execute" Shortcut="Ctrl+R"/>
  <Command x:Name="cmd_al_justify" Label="{Res cmd_al_justify}" SmallIcon="AlignJustify" IsCheckable="true" Checked="{Binding AlignJustify}" OnExecute="al_justify_execute" Shortcut="Ctrl+J"/>
  <Command x:Name="cmd_ind_dec" Label="{Res cmd_ind_dec}" SmallIcon="IndentDecrease" OnExecute="ind_dec_execute"/>
  <Command x:Name="cmd_ind_inc" Label="{Res cmd_ind_inc}" SmallIcon="IndentIncrease" OnExecute="ind_inc_execute"/>
  <Command x:Name="cmd_ls" Label="{Res cmd_ls}" SmallIcon="SquareSplitVertical"/>
  <Command x:Name="cmd_ls1" Label="{Res cmd_ls1}" IsCheckable="true" Checked="{Binding Ls1}" OnExecute="ls1_execute"/>
  <Command x:Name="cmd_ls1_15" Label="{Res cmd_ls1_15}" IsCheckable="true" Checked="{Binding Ls115}" OnExecute="ls1_15_execute"/>
  <Command x:Name="cmd_ls1_5" Label="{Res cmd_ls1_5}" IsCheckable="true" Checked="{Binding Ls15}" OnExecute="ls1_5_execute"/>
  <Command x:Name="cmd_ls2" Label="{Res cmd_ls2}" IsCheckable="true" Checked="{Binding Ls2}" OnExecute="ls2_execute"/>
  <Command x:Name="cmd_ls2_5" Label="{Res cmd_ls2_5}" IsCheckable="true" Checked="{Binding Ls25}" OnExecute="ls2_5_execute"/>
  <Command x:Name="cmd_ls3" Label="{Res cmd_ls3}" IsCheckable="true" Checked="{Binding Ls3}" OnExecute="ls3_execute"/>
  <Command x:Name="cmd_sp_before" Label="{Res cmd_sp_before}" IsCheckable="true" Checked="{Binding SpaceBefore}" OnExecute="sp_before_execute"/>
  <Command x:Name="cmd_sp_after" Label="{Res cmd_sp_after}" IsCheckable="true" Checked="{Binding SpaceAfter}" OnExecute="sp_after_execute"/>
  <Command x:Name="cmd_sortasc" Label="{Res cmd_sortasc}" SmallIcon="ArrowDownAZ"/>
