  <Command x:Name="cmd_tt_tabs" Label="{Res cmd_tt_tabs}"/>
  <Command x:Name="cmd_tt_quotes" Label="{Res cmd_tt_quotes}"/>
  <Command x:Name="cmd_tt_number" Label="{Res cmd_tt_number}"/>
