  </Ribbon>

  <!-- Rechercher / Remplacer (Ctrl+F / Ctrl+H), under the ribbon: the matches are found in the
       document's text block by block, Enter goes to the next one, Échap closes the bar. -->
  <Panel x:Name="find_bar" Dock="Top" Height="44" BackColor="Surface1" Visible="{Binding ShowFind}">
    <Panel x:Name="find_rule" Dock="Bottom" Height="1" BackColor="Border"/>
    <TextField x:Name="find_box" Text="{Binding FindText, Mode=TwoWay}" Placeholder="{Res find_placeholder}" AccessibleName="{Res find_placeholder}" X="12" Y="6" Width="220" Height="32" OnTextChanged="find_text_changed" OnKeyDown="find_key_down"/>
    <TextField x:Name="replace_box" Text="{Binding ReplaceText, Mode=TwoWay}" Placeholder="{Res replace_placeholder}" AccessibleName="{Res replace_placeholder}" X="240" Y="6" Width="200" Height="32" Visible="{Binding ShowReplace}"/>
    <CheckBox x:Name="find_case" Text="{Res find_match_case}" X="452" Y="12" Width="160" Height="20" OnCheckedChanged="find_case_changed"/>
    <Button x:Name="find_prev" Text="{Res find_prev}" Variant="Secondary" X="616" Y="6" Width="96" Height="32" OnClick="find_prev_click"/>
    <Button x:Name="find_next" Text="{Res find_next}" Variant="Primary" X="716" Y="6" Width="96" Height="32" OnClick="find_next_click"/>
    <Button x:Name="find_replace" Text="{Res find_replace}" Variant="Secondary" X="816" Y="6" Width="104" Height="32" Visible="{Binding ShowReplace}" OnClick="find_replace_click"/>
    <Button x:Name="find_replace_all" Text="{Res find_replace_all}" Variant="Secondary" X="924" Y="6" Width="128" Height="32" Visible="{Binding ShowReplace}" OnClick="find_replace_all_click"/>
    <Label x:Name="find_count" Text="{Binding FindStatus}" X="1060" Y="12" Width="120" Height="20"/>
    <IconButton x:Name="find_close" Icon="X" Diameter="32" Glyph="16" AccessibleName="{Res find_close}" X="1236" Y="6" Width="32" Height="32" Anchor="Top, Right" OnClick="find_close_click"/>
  </Panel>

  <!-- The status bar: the page and what is not drawn on the left, the zoom on the right. -->
  <Panel x:Name="status_band" Dock="Bottom" Height="22" BackColor="Surface1">
    <Panel x:Name="status_rule" Dock="Top" Height="1" BackColor="Border"/>
    <ZoomSlider x:Name="zoom_slider" Dock="Right" Width="228" Value="{Binding ZoomPercent}" OnValueChanged="zoom_slider_value_changed"/>
    <StatusBar x:Name="status_bar" Dock="Fill">
      <StatusLabel x:Name="status_page" Text="{Binding PageText}"/>
      <StatusLabel x:Name="status_hidden" Text="{Binding HiddenStatus}" ForeColor="Caution" Visible="{Binding HasHidden}"/>
      <StatusLabel x:Name="status_sync" Text="{Binding SyncStatus}" Visible="{Binding HasSync}"/>
      <StatusLabel x:Name="status_spring" Spring="true"/>
    </StatusBar>
  </Panel>

  <!-- The vertical ruler, under the tab-type selector where the two rulers meet. -->
  <Panel x:Name="ruler_column" Dock="Left" Width="20" Visible="{Binding ShowRuler}">
    <RulerCorner x:Name="ruler_corner" Dock="Top" Height="20" TabType="{Binding TabType}" OnTabTypeChanged="ruler_corner_tab_type_changed"/>
    <VerticalRuler x:Name="vertical_ruler" Dock="Fill" PageHeight="{Binding PageHeight}" MarginTop="{Binding MarginTop}" MarginBottom="{Binding MarginBottom}"
                   Zoom="{Binding Zoom}" PageTop="{Binding PageTop}"
                   OnMarginsChanged="vertical_ruler_margins_changed" OnDragGuideChanged="vertical_ruler_drag_guide_changed"/>
  </Panel>

  <!-- The page, with the horizontal ruler laid over its top: its band covers the canvas's top
       20 DIP (ViewportTop) and its markers hang over the page through its transparent overhang. -->
  <Panel x:Name="page_host" Dock="Fill">
    <PageCanvas x:Name="page" Dock="Fill" ViewportTop="{Binding RulerInset}" ContextMenu="page_menu" OnViewChanged="page_view_changed" OnEditorStateChanged="page_editor_state_changed"/>
    <HorizontalRuler x:Name="horizontal_ruler" X="0" Y="0" Width="1260" Height="25" Anchor="Top, Left, Right" Visible="{Binding ShowRuler}"
                     PageWidth="{Binding PageWidth}" MarginLeft="{Binding MarginLeft}" MarginRight="{Binding MarginRight}" Zoom="{Binding Zoom}"
                     Origin="{Binding PageOrigin}" IndentLeft="{Binding IndentLeft}" IndentFirstLine="{Binding IndentFirstLine}"
                     IndentRight="{Binding IndentRight}" TabStops="{Binding TabStops}" TabType="{Binding TabType}"
                     OnMarginsChanged="horizontal_ruler_margins_changed" OnIndentsChanged="horizontal_ruler_indents_changed"
                     OnTabStopsChanged="horizontal_ruler_tab_stops_changed" OnDragGuideChanged="horizontal_ruler_drag_guide_changed"/>
  </Panel>
</Panel>
