  <Command x:Name="cmd_header" Label="{Res cmd_header}" SmallIcon="PanelTop"/>
  <Command x:Name="cmd_footer" Label="{Res cmd_footer}" SmallIcon="PanelBottom"/>
  <Command x:Name="cmd_ins_toc" Label="{Res cmd_ins_toc}" SmallIcon="ListTree"/>
  <Command x:Name="cmd_toc_ins" Label="{Res cmd_toc_ins}"/>
  <Command x:Name="cmd_ins_toc_upd" Label="{Res cmd_ins_toc_upd}"/>
  <Command x:Name="cmd_fld_upd" Label="{Res cmd_fld_upd}" SmallIcon="RotateCw"/>
  <Command x:Name="cmd_special" Label="{Res cmd_special}" SmallIcon="Omega"/>
  <Command x:Name="cmd_datetime" Label="{Res cmd_datetime}" SmallIcon="CalendarClock"/>
  <Command x:Name="cmd_fld_date" Label="{Res cmd_fld_date}"/>
  <Command x:Name="cmd_fld_time" Label="{Res cmd_fld_time}"/>
  <Command x:Name="cmd_fld_datetime" Label="{Res cmd_fld_datetime}"/>
  <Command x:Name="cmd_ins_caption" Label="{Res cmd_ins_caption}" SmallIcon="Captions"/>
  <Command x:Name="cmd_hr" Label="{Res cmd_hr}" SmallIcon="Minus" OnExecute="hr_execute"/>
  <Command x:Name="cmd_quote" Label="{Res cmd_quote}" SmallIcon="Quote"/>
  <Command x:Name="cmd_code" Label="{Res cmd_code}" SmallIcon="Code" IsCheckable="true" Checked="{Binding CodeBlock}" OnExecute="code_execute"/>
  <Command x:Name="cmd_footnote" Label="{Res cmd_footnote}" SmallIcon="Superscript"/>
  <Command x:Name="cmd_endnote" Label="{Res cmd_endnote}" SmallIcon="BookOpen"/>
  <Command x:Name="cmd_dropcap" Label="{Res cmd_dropcap}" SmallIcon="Type"/>
  <Command x:Name="cmd_sign" Label="{Res cmd_sign}" SmallIcon="Pencil"/>
  <Command x:Name="cmd_pagexy" Label="{Res cmd_pagexy}" SmallIcon="Hash"/>
  <Command x:Name="cmd_symbols" Label="{Res cmd_symbols}" SmallIcon="Omega"/>
  <Command x:Name="cmd_sym_emdash" Label="{Res cmd_sym_emdash}" OnExecute="sym_emdash_execute"/>
  <Command x:Name="cmd_sym_endash" Label="{Res cmd_sym_endash}" OnExecute="sym_endash_execute"/>
  <Command x:Name="cmd_sym_ellipsis" Label="{Res cmd_sym_ellipsis}" OnExecute="sym_ellipsis_execute"/>
  <Command x:Name="cmd_sym_nbsp" Label="{Res cmd_sym_nbsp}" OnExecute="sym_nbsp_execute"/>
  <Command x:Name="cmd_sym_guillemets" Label="{Res cmd_sym_guillemets}" OnExecute="sym_guillemets_execute"/>
  <Command x:Name="cmd_sym_euro" Label="{Res cmd_sym_euro}" OnExecute="sym_euro_execute"/>
  <Command x:Name="cmd_sym_tm" Label="{Res cmd_sym_tm}" OnExecute="sym_tm_execute"/>
  <Command x:Name="cmd_sym_copyright" Label="{Res cmd_sym_copyright}" OnExecute="sym_copyright_execute"/>
  <Command x:Name="cmd_sym_registered" Label="{Res cmd_sym_registered}" OnExecute="sym_registered_execute"/>
  <Command x:Name="cmd_sym_section" Label="{Res cmd_sym_section}" OnExecute="sym_section_execute"/>
  <Command x:Name="cmd_sym_bullet" Label="{Res cmd_sym_bullet}" OnExecute="sym_bullet_execute"/>
  <Command x:Name="cmd_sym_degree" Label="{Res cmd_sym_degree}" OnExecute="sym_degree_execute"/>
  <Command x:Name="cmd_sym_times" Label="{Res cmd_sym_times}" OnExecute="sym_times_execute"/>
  <Command x:Name="cmd_sym_divide" Label="{Res cmd_sym_divide}" OnExecute="sym_divide_execute"/>
  <Command x:Name="cmd_sym_plusminus" Label="{Res cmd_sym_plusminus}" OnExecute="sym_plusminus_execute"/>
  <Command x:Name="cmd_sym_arrow" Label="{Res cmd_sym_arrow}" OnExecute="sym_arrow_execute"/>
  <Command x:Name="cmd_sym_notequal" Label="{Res cmd_sym_notequal}" OnExecute="sym_notequal_execute"/>
  <Command x:Name="cmd_sym_half" Label="{Res cmd_sym_half}" OnExecute="sym_half_execute"/>
  <Command x:Name="cmd_sym_approx" Label="{Res cmd_sym_approx}" OnExecute="sym_approx_execute"/>
  <Command x:Name="cmd_sym_infinity" Label="{Res cmd_sym_infinity}" OnExecute="sym_infinity_execute"/>
  <Command x:Name="cmd_sym_sqrt" Label="{Res cmd_sym_sqrt}" OnExecute="sym_sqrt_execute"/>
  <Command x:Name="cmd_sym_sum" Label="{Res cmd_sym_sum}" OnExecute="sym_sum_execute"/>
  <Command x:Name="cmd_sym_pi" Label="{Res cmd_sym_pi}" OnExecute="sym_pi_execute"/>
  <Command x:Name="cmd_sym_delta" Label="{Res cmd_sym_delta}" OnExecute="sym_delta_execute"/>
  <Command x:Name="cmd_margins" Label="{Res cmd_margins}" SmallIcon="SquareDashed"/>
  <Command x:Name="cmd_mg_normal" Label="{Res cmd_mg_normal}" OnExecute="mg_normal_execute"/>
  <Command x:Name="cmd_mg_narrow" Label="{Res cmd_mg_narrow}" OnExecute="mg_narrow_execute"/>
  <Command x:Name="cmd_mg_moderate" Label="{Res cmd_mg_moderate}" OnExecute="mg_moderate_execute"/>
  <Command x:Name="cmd_mg_wide" Label="{Res cmd_mg_wide}" OnExecute="mg_wide_execute"/>
  <Command x:Name="cmd_pagecolor" Label="{Res cmd_pagecolor}" SmallIcon="PaintBucket"/>
  <Command x:Name="cmd_pc_none" Label="{Res cmd_pc_none}"/>
  <Command x:Name="cmd_pc_cream" Label="{Res cmd_pc_cream}"/>
  <Command x:Name="cmd_pc_grey" Label="{Res cmd_pc_grey}"/>
  <Command x:Name="cmd_watermark" Label="{Res cmd_watermark}" SmallIcon="Droplet"/>
  <Command x:Name="cmd_pageborder" Label="{Res cmd_pageborder}" SmallIcon="Frame"/>
  <Command x:Name="cmd_toc_auto1" Label="{Res cmd_toc_auto1}"/>
  <Command x:Name="cmd_toc_auto2" Label="{Res cmd_toc_auto2}"/>
  <Command x:Name="cmd_toc_manual" Label="{Res cmd_toc_manual}"/>
  <Command x:Name="cmd_toc_custom" Label="{Res cmd_toc_custom}"/>
  <Command x:Name="cmd_toc_remove" Label="{Res cmd_toc_remove}"/>
  <Command x:Name="cmd_ol_0" Label="{Res cmd_ol_0}"/>
  <Command x:Name="cmd_ol_1" Label="{Res cmd_ol_1}"/>
  <Command x:Name="cmd_ol_2" Label="{Res cmd_ol_2}"/>
  <Command x:Name="cmd_ol_3" Label="{Res cmd_ol_3}"/>
  <Command x:Name="cmd_ref_toc_upd" Label="{Res cmd_ref_toc_upd}" SmallIcon="RotateCw" Enabled="false"/>
  <Command x:Name="cmd_fn" Label="{Res cmd_fn}" SmallIcon="Superscript"/>
  <Command x:Name="cmd_en" Label="{Res cmd_en}" SmallIcon="BookOpen"/>
  <Command x:Name="cmd_nextnote" Label="{Res cmd_nextnote}" SmallIcon="Superscript"/>
  <Command x:Name="cmd_note_footnote_next" Label="{Res cmd_note_footnote_next}"/>
  <Command x:Name="cmd_note_footnote_prev" Label="{Res cmd_note_footnote_prev}"/>
  <Command x:Name="cmd_note_endnote_next" Label="{Res cmd_note_endnote_next}"/>
  <Command x:Name="cmd_note_endnote_prev" Label="{Res cmd_note_endnote_prev}"/>
  <Command x:Name="cmd_shownotes" Label="{Res cmd_shownotes}" SmallIcon="FileText" Enabled="false"/>
  <Command x:Name="cmd_cite_new" Label="{Res cmd_cite_new}"/>
  <Command x:Name="cmd_cite_pick" Label="{Res cmd_cite_pick}"/>
  <Command x:Name="cmd_sources" Label="{Res cmd_sources}" SmallIcon="BookMarked"/>
  <Command x:Name="cmd_biblio_bibliography" Label="{Res cmd_biblio_bibliography}"/>
  <Command x:Name="cmd_biblio_references" Label="{Res cmd_biblio_references}"/>
  <Command x:Name="cmd_biblio_works" Label="{Res cmd_biblio_works}"/>
  <Command x:Name="cmd_ref_caption" Label="{Res cmd_ref_caption}" SmallIcon="Quote"/>
  <Command x:Name="cmd_tof" Label="{Res cmd_tof}" SmallIcon="ListTree"/>
  <Command x:Name="cmd_tof_upd" Label="{Res cmd_tof_upd}" SmallIcon="RotateCw"/>
  <Command x:Name="cmd_xref" Label="{Res cmd_xref}" SmallIcon="Hash"/>
  <Command x:Name="cmd_xe" Label="{Res cmd_xe}" SmallIcon="Tag"/>
  <Command x:Name="cmd_idx_ins" Label="{Res cmd_idx_ins}" SmallIcon="ListTree"/>
  <Command x:Name="cmd_idx_upd" Label="{Res cmd_idx_upd}" SmallIcon="RotateCw" Enabled="false"/>
  <Command x:Name="cmd_ta" Label="{Res cmd_ta}" SmallIcon="BookMarked"/>
  <Command x:Name="cmd_toa_ins" Label="{Res cmd_toa_ins}" SmallIcon="ListTree"/>
  <Command x:Name="cmd_toa_upd" Label="{Res cmd_toa_upd}" SmallIcon="RotateCw" Enabled="false"/>
  <Command x:Name="cmd_edit" Label="{Res cmd_edit}" SmallIcon="FileText"/>
  <Command x:Name="cmd_read" Label="{Res cmd_read}" SmallIcon="Eye" Checked="true"/>
  <Command x:Name="cmd_ruler" Label="{Res cmd_ruler}" SmallIcon="Ruler" IsCheckable="true" Checked="{Binding ShowRuler, Mode=TwoWay}" OnExecute="ruler_execute"/>
  <Command x:Name="cmd_nav" Label="{Res cmd_nav}" SmallIcon="PanelLeft"/>
  <Command x:Name="cmd_bounds" Label="{Res cmd_bounds}" SmallIcon="Frame"/>
  <Command x:Name="cmd_marks" Label="{Res cmd_marks}" SmallIcon="Pilcrow" IsCheckable="true" Checked="{Binding ShowMarks, Mode=TwoWay}" OnExecute="marks_execute"/>
  <Command x:Name="cmd_outarrows" Label="{Res cmd_outarrows}" SmallIcon="ChevronRight"/>
  <Command x:Name="cmd_zdlg" Label="{Res cmd_zdlg}" SmallIcon="ZoomIn" ScreenTipTitle="{Res cmd_zdlg_tip}"/>
  <Command x:Name="cmd_z100" Label="{Res cmd_z100}" SmallIcon="FileText" OnExecute="zoom_100_execute"/>
  <Command x:Name="cmd_z1p" Label="{Res cmd_z1p}" SmallIcon="FileText" OnExecute="zoom_one_page_execute"/>
  <Command x:Name="cmd_zmp" Label="{Res cmd_zmp}" SmallIcon="Files"/>
  <Command x:Name="cmd_zpw" Label="{Res cmd_zpw}" SmallIcon="MoveHorizontal" OnExecute="zoom_page_width_execute"/>
  <Command x:Name="cmd_mac_show" Label="{Res cmd_mac_show}"/>
  <Command x:Name="cmd_mac_rec" Label="{Res cmd_mac_rec}"/>
  <Command x:Name="cmd_mac_pause" Label="{Res cmd_mac_pause}" Enabled="false"/>
  <Command x:Name="cmd_spell" Label="{Res cmd_spell}" SmallIcon="SpellCheck"/>
  <Command x:Name="cmd_spelldict" Label="{Res cmd_spelldict}" SmallIcon="BookMarked"/>
  <Command x:Name="cmd_trackchanges" Label="{Res cmd_trackchanges}" SmallIcon="PenLine"/>
  <Command x:Name="cmd_reviewpane" Label="{Res cmd_reviewpane}" SmallIcon="ListChecks"/>
  <Command x:Name="cmd_revfinal" Label="{Res cmd_revfinal}" SmallIcon="Eye"/>
  <Command x:Name="cmd_addcomment" Label="{Res cmd_addcomment}" SmallIcon="MessageSquarePlus"/>
  <Command x:Name="cmd_showcomments" Label="{Res cmd_showcomments}" SmallIcon="MessageSquare"/>

  <!-- The right-click menu of the page: the web's buildCtxItems, minus what the desktop does not have yet. -->
  <ContextMenu x:Name="page_menu">
    <MenuItem Command="cmd_cut"/>
    <MenuItem Command="cmd_copy"/>
    <MenuItem Command="cmd_paste"/>
    <MenuItem Command="cmd_paste_plain" ShortcutKeyDisplayString="Ctrl+Maj+V"/>
    <MenuSeparator/>
    <MenuItem Command="cmd_link"/>
    <MenuSeparator/>
    <MenuItem Text="{Res menu_break}">
      <MenuItem Command="cmd_pb"/>
    </MenuItem>
    <MenuSeparator/>
    <MenuItem Text="{Res menu_text}">
      <MenuItem Command="cmd_bold"/>
      <MenuItem Command="cmd_italic"/>
      <MenuItem Command="cmd_underline"/>
      <MenuItem Command="cmd_strike"/>
    </MenuItem>
    <MenuItem Text="{Res menu_align}">
      <MenuItem Command="cmd_al_left"/>
      <MenuItem Command="cmd_al_center"/>
      <MenuItem Command="cmd_al_right"/>
      <MenuItem Command="cmd_al_justify"/>
    </MenuItem>
    <MenuSeparator/>
    <MenuItem Command="cmd_select_all" ShortcutKeyDisplayString="Ctrl+A"/>
  </ContextMenu>

  <Ribbon x:Name="ribbon" Dock="Top" Tone="Documents">
    <RibbonQuickAccessToolbar>
      <RibbonButton x:Name="qat_save" Command="cmd_save"/>
      <RibbonButton x:Name="qat_undo" Command="cmd_undo"/>
      <RibbonButton x:Name="qat_redo" Command="cmd_redo"/>
    </RibbonQuickAccessToolbar>
    <RibbonBackstage x:Name="backstage" Header="{Res tab_file}" KeyTip="F">
      <BackstageTab x:Name="bs_info" Header="{Res bs_info}" Icon="Info">
        <BackstageInfo x:Name="backstage_info" DocumentTitle="{Binding DocTitle}" Pages="{Binding PagesText}" ZoomText="{Binding ZoomText}" Hidden="{Binding HiddenText}"/>
      </BackstageTab>
      <BackstageSeparator/>
      <BackstageButton x:Name="bs_close" Label="{Res bs_close}" SmallIcon="X" OnClick="bs_close_click"/>
    </RibbonBackstage>
    <RibbonTab x:Name="tab_home" Header="{Res tab_home}" KeyTip="H">
