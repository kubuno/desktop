<!--
  The account panel (the web's AccountMenu): its header stays put — the active account's address and a close
  button — while the rest scrolls under it: the avatar (a 3 white outline, the camera button at its bottom right),
  « Bonjour … ! », « Gérer votre compte », the other accounts' card (AccountsCard: it folds; a click switches, a
  dead session or another instance's account shows its buttons), then « Ajouter un compte », « Étiquettes »,
  « Administration » (ShowAdmin) and « Se déconnecter ». 320 wide; the host sizes it to ContentHeight and puts it
  in a popup (AccountButton). Every click raises an event; the host acts on it and closes the popup.
-->
<UserControl x:Class="AccountMenu" DesignWidth="320" DesignHeight="553" d:BackColor="#E9EEF6" OnLoad="account_menu_load">
  <Panel x:Name="head" Dock="Top" Height="44.6">
    <Label x:Name="email_label" Text="{Binding Email}" d:Text="camille.martin@exemple.fr" ForeColor="TextSecondary" TextAlign="MiddleCenter" X="40.6" Y="16.6" Width="238.8" Height="20"/>
    <IconButton x:Name="close_button" Icon="X" Diameter="32" Glyph="16" ToolTip="{Res account_close_tip, Source=shell_controls}" X="275.4" Y="12" Width="32" Height="32" OnClick="close_button_click"/>
  </Panel>
  <Panel x:Name="body" Dock="Fill" AutoScroll="true">
    <Avatar x:Name="avatar" DisplayName="{Binding UserName}" Initials="{Binding Initials}" d:DisplayName="Camille Martin" d:Initials="CM" Image="{Binding AvatarPath}" Tint="Primary" AvatarSize="96" X="112" Y="8" Width="96" Height="96"/>
    <AvatarDecor x:Name="avatar_decor" ShowCamera="true" Busy="{Binding AvatarBusy}" AccessibleName="{Res account_change_photo, Source=shell_controls}" X="109" Y="5" Width="102" Height="102" OnCameraClicked="avatar_decor_camera_clicked"/>
    <Label x:Name="greeting_label" Text="{Binding Greeting}" d:Text="Bonjour Camille !" Role="Page" TextAlign="MiddleCenter" X="24.6" Y="116" Width="270.8" Height="32"/>
    <AccentPill x:Name="manage" AccessibleRole="PushButton" Text="{Res account_manage, Source=shell_controls}" X="77.7" Y="160" Width="164.6" Height="33.1" OnClick="manage_click"/>
    <Panel x:Name="cards" X="8.6" Y="209.1" Width="302.8">
      <AccountsCard x:Name="accounts" Accounts="{Binding Accounts}" Expanded="{Binding Expanded}" Busy="{Binding Busy}" AccessibleName="{Res account_others, Source=shell_controls}" AccessibleRole="List" Visible="{Binding HasOthers}" Dock="Top" AutoSize="true" OnOpenAccount="accounts_open_account" OnRemoveAccount="accounts_remove_account" OnExpandedChanged="accounts_expanded_changed"/>
      <Panel x:Name="gap" Visible="{Binding HasOthers}" Dock="Top" Height="8"/>
      <PanelMenu x:Name="actions" Items="{Binding ActionRows}" AccessibleName="{Res account_actions, Source=shell_controls}" AccessibleRole="List" Divided="true" Dock="Top" AutoSize="true" OnItemClicked="actions_item_clicked"/>
    </Panel>
  </Panel>
</UserControl>
