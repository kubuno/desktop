<!--
  The dock and the workspace chrome (`registry/families/docking.rs`), as a
  `.kbview`: the PaintSharp « Layer » editor of the web
  (`defaultArrangement={{ right: [['navigator'], ['layers'], ['brush', 'adjust', 'filters']] }}`)
  plus a left tree panel. Opened by `examples/view_preview.rs`:

    (the `view_preview` example, with this file as its argument)

  Drag a tab onto the guide diamond, off it to float the panel, right-click it
  for its menu; the layout is saved under `StorageKey`.
-->
<WorkspaceShell xmlns="https://kubuno.com/views" xmlns:x="https://kubuno.com/views/x" Title="Affiche festival" Subtitle="Layer" DocInfo="1920×1080" Icon="Image"
                ShowBack="true" ShowSearch="true" StatusText="100 % | RVB/8 | Calque 2">
  <DockArea x:Name="dock" StorageKey="kbview-dock-demo">
    <DockPanel x:Name="tree" Title="Arborescence" Side="Left" Icon="ListTree">
      <Stack Direction="TopDown" Gap="6" Padding="12">
        <Label Text="Document"/>
        <Label Text="Calque « Titre »"/>
        <Label Text="Calque « Soleil »"/>
      </Stack>
    </DockPanel>
    <DockPanel x:Name="navigator" Title="Navigateur" Icon="Map">
      <Stack Direction="TopDown" Gap="8" Padding="12">
        <Slider Value="100" Minimum="10" Maximum="400"/>
        <Label Text="Zoom : 100 %"/>
      </Stack>
    </DockPanel>
    <DockPanel x:Name="layers" Title="Calques" Icon="Layers">
      <Stack Direction="TopDown" Gap="8" Padding="12">
        <CheckBox Text="Titre" Checked="true"/>
        <CheckBox Text="Soleil" Checked="true"/>
        <CheckBox Text="Fond" Checked="true"/>
      </Stack>
    </DockPanel>
    <DockPanel x:Name="brush" Title="Pinceau" Group="tools" Active="true">
      <Stack Direction="TopDown" Gap="8" Padding="12">
        <Label Text="Taille"/>
        <Slider Value="24" Minimum="1" Maximum="200"/>
        <Button Text="Réinitialiser" Variant="Secondary"/>
      </Stack>
    </DockPanel>
    <DockPanel x:Name="adjust" Title="Réglages" Group="tools">
      <Stack Direction="TopDown" Gap="8" Padding="12">
        <Switch Label="Noir et blanc" On="{Binding Notifications, Mode=TwoWay}"/>
        <Switch Label="Inverser" On="{Binding Offline, Mode=TwoWay}"/>
      </Stack>
    </DockPanel>
    <DockPanel x:Name="filters" Title="Filtres" Group="tools" Closable="false">
      <Stack Direction="TopDown" Gap="8" Padding="12">
        <Button Text="Flou gaussien" Variant="Ghost"/>
        <Button Text="Netteté" Variant="Ghost"/>
      </Stack>
    </DockPanel>
    <Panel>
      <Label Text="Zone de travail (le contenu central de la DockArea)" X="24" Y="24" Width="420" Height="24"/>
    </Panel>
  </DockArea>
</WorkspaceShell>
