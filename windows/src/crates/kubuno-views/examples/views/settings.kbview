<!--
  A restriction of `vskubuno/docs/XML_VIEWS.md` §7's worked example to the
  five components phase 2a/2c actually register (Button, Switch, TextField,
  Card, Stack — no Panel/RadioButtons/NumericField/ScrollArea yet, see
  `kubuno-views/src/lib.rs`'s module doc for why). Opened by
  `examples/view_preview.rs`.

  Two-way binding: `Notifications` and `Proxy` write straight back to
  `SettingsViewModel` on every toggle/keystroke. One-way + handler: `Offline`
  mirrors §7's own reasoning — it is not persisted on the model, so binding it
  two-way would be silently wrong; `offline_toggled` is where the real side
  effect belongs.

  Try editing this file while `view_preview` is running: change `Variant` on
  the button below, or `Text`, and save — the window picks it up within
  ~250 ms, without losing whatever you typed into the proxy field.
-->
<Card xmlns="https://kubuno.com/views" xmlns:x="https://kubuno.com/views/x" Title="Réglages" Subtitle="Aperçu en direct — kubuno-views">
  <Stack Direction="TopDown" Gap="16" Padding="0">
    <Switch x:Name="notifications"
            Label="Notifications"
            Description="Recevoir un e-mail par nouvelle activité."
            On="{Binding Notifications, Mode=TwoWay}"/>
    <Switch x:Name="offline"
            Label="Travailler hors ligne"
            On="{Binding Offline}"
            OnToggled="offline_toggled"/>
    <TextField x:Name="proxy"
               Placeholder="http://hôte:port (aucun)"
               Text="{Binding Proxy, Mode=TwoWay}"/>
    <Button x:Name="save"
            Text="Enregistrer"
            Variant="Primary"
            OnClick="save_clicked"/>
  </Stack>
</Card>
