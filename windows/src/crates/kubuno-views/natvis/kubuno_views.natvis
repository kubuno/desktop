<?xml version="1.0" encoding="utf-8"?>
<!--
  Debugger views of the kubuno_views/kubuno_ui types for Visual Studio's native debugger (vskubuno docs/DEBUGGING.md),
  plus Option/Result shown with their payload - Some("two"), Ok(42) - and a few standard-library types the Rust
  toolchain's own natvis leaves raw (Mutex, RwLock, PathBuf, Box<dyn Trait>).

  Embedded in the PDB of every application that links kubuno_views, by `#![debugger_visualizer]` in src/lib.rs: it
  travels with the crate version whose layouts it describes, and, being in the PDB like the toolchain's natvis, its
  Option/Result entries win over the toolchain's generic `enum2$<*>` view (a natvis loaded from anywhere else is
  looked at after the PDB's and cannot override it). vskubuno ships a copy as a VSIX NativeVisualizer asset for the
  modules whose PDB does not embed it (kubuno_ui.dll's own frames, applications built against an older kubuno_views):
  keep both in sync.

  Names are the ones rustc writes into the PDB (`crate::module::Type`, `enum2$<...>` for enums, `ref$<...>` for
  references, `tuple$<...>`); expressions are the C++ expression evaluator's (no Rust method calls).
-->
<AutoVisualizer xmlns="http://schemas.microsoft.com/vstudio/debugger/natvis/2010">

  <!-- ===== Geometry and colours (kubuno_ui) ===== -->

  <Type Name="drive_app_controls::geometry::Rect">
    <DisplayString>{{X={left,g} Y={top,g} Width={right - left,g} Height={bottom - top,g}}}</DisplayString>
    <Expand>
      <Item Name="X">left</Item>
      <Item Name="Y">top</Item>
      <Item Name="Width">right - left</Item>
      <Item Name="Height">bottom - top</Item>
      <Item Name="Right">right</Item>
      <Item Name="Bottom">bottom</Item>
    </Expand>
  </Type>

  <Type Name="kubuno_ui::graphics::types::Color">
    <DisplayString>Color [A={(int)(a * 255.0f + 0.5f)}, R={(int)(r * 255.0f + 0.5f)}, G={(int)(g * 255.0f + 0.5f)}, B={(int)(b * 255.0f + 0.5f)}]</DisplayString>
    <Expand>
      <Item Name="A">(int)(a * 255.0f + 0.5f)</Item>
      <Item Name="R">(int)(r * 255.0f + 0.5f)</Item>
      <Item Name="G">(int)(g * 255.0f + 0.5f)</Item>
      <Item Name="B">(int)(b * 255.0f + 0.5f)</Item>
      <Item Name="[raw rgba]">*this,!</Item>
    </Expand>
  </Type>

  <Type Name="kubuno_ui::graphics::types::PointF">
    <DisplayString>{{X={x,g} Y={y,g}}}</DisplayString>
  </Type>

  <Type Name="kubuno_ui::graphics::types::SizeF">
    <DisplayString>{{Width={width,g} Height={height,g}}}</DisplayString>
  </Type>

  <!-- ===== Option, Result: the value in the Value column, like a C# nullable ===== -->
  <!-- The toolchain's generic enum2$<*> view shows only the variant name ("Some", "Ok"); these more specific entries
       show the payload too - Some("two"), Ok(42), Err("not found") - and expand straight to it. Same tag logic as
       the toolchain's intrinsic.natvis (exact discriminant, or a niche range). -->
  <Type Name="enum2$&lt;core::option::Option&lt;*&gt; &gt;">
    <Intrinsic Name="in_range" Expression="(begin &lt;= end) ? ((x &gt;= begin) &amp;&amp; (x &lt;= end)) : ((x &gt;= begin) || (x &lt;= end))">
      <Parameter Name="x" Type="unsigned __int64" />
      <Parameter Name="begin" Type="unsigned __int64" />
      <Parameter Name="end" Type="unsigned __int64" />
    </Intrinsic>    <DisplayString Condition="tag == variant0.DISCR_EXACT" Optional="true">None</DisplayString>
    <DisplayString Condition="in_range(tag, variant0.DISCR_BEGIN, variant0.DISCR_END)" Optional="true">None</DisplayString>
    <DisplayString Condition="tag == variant1.DISCR_EXACT" Optional="true">Some({variant1.value.__0})</DisplayString>
    <DisplayString Condition="in_range(tag, variant1.DISCR_BEGIN, variant1.DISCR_END)" Optional="true">Some({variant1.value.__0})</DisplayString>
    <Expand HideRawView="false">
      <ExpandedItem Condition="tag == variant1.DISCR_EXACT" Optional="true">variant1.value.__0</ExpandedItem>
      <ExpandedItem Condition="in_range(tag, variant1.DISCR_BEGIN, variant1.DISCR_END)" Optional="true">variant1.value.__0</ExpandedItem>
    </Expand>
  </Type>

  <Type Name="enum2$&lt;core::result::Result&lt;*,*&gt; &gt;">
    <Intrinsic Name="in_range" Expression="(begin &lt;= end) ? ((x &gt;= begin) &amp;&amp; (x &lt;= end)) : ((x &gt;= begin) || (x &lt;= end))">
      <Parameter Name="x" Type="unsigned __int64" />
      <Parameter Name="begin" Type="unsigned __int64" />
      <Parameter Name="end" Type="unsigned __int64" />
    </Intrinsic>    <DisplayString Condition="tag == variant0.DISCR_EXACT" Optional="true">Ok({variant0.value.__0})</DisplayString>
    <DisplayString Condition="in_range(tag, variant0.DISCR_BEGIN, variant0.DISCR_END)" Optional="true">Ok({variant0.value.__0})</DisplayString>
    <DisplayString Condition="tag == variant1.DISCR_EXACT" Optional="true">Err({variant1.value.__0})</DisplayString>
    <DisplayString Condition="in_range(tag, variant1.DISCR_BEGIN, variant1.DISCR_END)" Optional="true">Err({variant1.value.__0})</DisplayString>
    <Expand HideRawView="false">
      <ExpandedItem Condition="tag == variant0.DISCR_EXACT" Optional="true">variant0.value.__0</ExpandedItem>
      <ExpandedItem Condition="in_range(tag, variant0.DISCR_BEGIN, variant0.DISCR_END)" Optional="true">variant0.value.__0</ExpandedItem>
      <ExpandedItem Condition="tag == variant1.DISCR_EXACT" Optional="true">variant1.value.__0</ExpandedItem>
      <ExpandedItem Condition="in_range(tag, variant1.DISCR_BEGIN, variant1.DISCR_END)" Optional="true">variant1.value.__0</ExpandedItem>
    </Expand>
  </Type>

  <!-- kubuno_views::binding::Value: Bool(true), F32(1.5), Str("text"), List(3 rows). -->
  <Type Name="enum2$&lt;kubuno_views::binding::Value&gt;">
    <Intrinsic Name="in_range" Expression="(begin &lt;= end) ? ((x &gt;= begin) &amp;&amp; (x &lt;= end)) : ((x &gt;= begin) || (x &lt;= end))">
      <Parameter Name="x" Type="unsigned __int64" />
      <Parameter Name="begin" Type="unsigned __int64" />
      <Parameter Name="end" Type="unsigned __int64" />
    </Intrinsic>    <DisplayString Condition="tag == variant0.DISCR_EXACT" Optional="true">Bool({variant0.value.__0})</DisplayString>
    <DisplayString Condition="in_range(tag, variant0.DISCR_BEGIN, variant0.DISCR_END)" Optional="true">Bool({variant0.value.__0})</DisplayString>
    <DisplayString Condition="tag == variant1.DISCR_EXACT" Optional="true">F32({variant1.value.__0,g})</DisplayString>
    <DisplayString Condition="in_range(tag, variant1.DISCR_BEGIN, variant1.DISCR_END)" Optional="true">F32({variant1.value.__0,g})</DisplayString>
    <DisplayString Condition="tag == variant2.DISCR_EXACT" Optional="true">Str({variant2.value.__0})</DisplayString>
    <DisplayString Condition="in_range(tag, variant2.DISCR_BEGIN, variant2.DISCR_END)" Optional="true">Str({variant2.value.__0})</DisplayString>
    <DisplayString Condition="tag == variant3.DISCR_EXACT" Optional="true">List({variant3.value.__0.len} rows)</DisplayString>
    <DisplayString Condition="in_range(tag, variant3.DISCR_BEGIN, variant3.DISCR_END)" Optional="true">List({variant3.value.__0.len} rows)</DisplayString>
    <Expand HideRawView="false">
      <ExpandedItem Condition="tag == variant0.DISCR_EXACT" Optional="true">variant0.value.__0</ExpandedItem>
      <ExpandedItem Condition="in_range(tag, variant0.DISCR_BEGIN, variant0.DISCR_END)" Optional="true">variant0.value.__0</ExpandedItem>
      <ExpandedItem Condition="tag == variant1.DISCR_EXACT" Optional="true">variant1.value.__0</ExpandedItem>
      <ExpandedItem Condition="in_range(tag, variant1.DISCR_BEGIN, variant1.DISCR_END)" Optional="true">variant1.value.__0</ExpandedItem>
      <ExpandedItem Condition="tag == variant2.DISCR_EXACT" Optional="true">variant2.value.__0</ExpandedItem>
      <ExpandedItem Condition="in_range(tag, variant2.DISCR_BEGIN, variant2.DISCR_END)" Optional="true">variant2.value.__0</ExpandedItem>
      <ExpandedItem Condition="tag == variant3.DISCR_EXACT" Optional="true">variant3.value.__0</ExpandedItem>
      <ExpandedItem Condition="in_range(tag, variant3.DISCR_BEGIN, variant3.DISCR_END)" Optional="true">variant3.value.__0</ExpandedItem>
    </Expand>
  </Type>
  <!-- ===== Bindings (kubuno_views::binding) ===== -->

  <!-- Row(Vec<(String, Value)>): one named field per line, like a DataRow. -->
  <Type Name="kubuno_views::binding::Row">
    <DisplayString>{{ fields={__0.len} }}</DisplayString>
    <Expand>
      <CustomListItems>
        <Variable Name="i" InitialValue="0" />
        <Variable Name="fields" InitialValue="(tuple$&lt;alloc::string::String,enum2$&lt;kubuno_views::binding::Value&gt; &gt; *)__0.buf.inner.ptr.pointer.pointer" />
        <Size>__0.len</Size>
        <Loop>
          <Break Condition="i == __0.len" />
          <Item Name="{fields[i].__0,sb}">fields[i].__1</Item>
          <Exec>i = i + 1</Exec>
        </Loop>
      </CustomListItems>
    </Expand>
  </Type>

  <Type Name="kubuno_views::binding::HandlerTable">
    <DisplayString>{{ handlers={handlers.base.table.table.items} typed={typed.base.table.table.items} }}</DisplayString>
    <Expand>
      <Item Name="[handlers]">handlers</Item>
      <Item Name="[typed]">typed</Item>
    </Expand>
  </Type>

  <Type Name="kubuno_views::binding::MapViewModel">
    <DisplayString>{__0}</DisplayString>
    <Expand>
      <ExpandedItem>__0</ExpandedItem>
    </Expand>
  </Type>

  <!-- ===== Events (kubuno_views::events) ===== -->

  <!-- ElementRef: `Button "hello"` - who raised the event. -->
  <Type Name="kubuno_views::events::sender::ElementRef">
    <DisplayString Condition="name.tag == name.variant0.DISCR_EXACT" Optional="true">{element,sb} (id {id,sb})</DisplayString>
    <DisplayString>{element,sb} {name.variant1.value.__0}</DisplayString>
    <Expand>
      <Item Name="Name">name</Item>
      <Item Name="Element">element</Item>
      <Item Name="Id">id</Item>
      <Item Name="Bounds">bounds</Item>
      <Item Name="FocusId">focus_id</Item>
      <Item Name="Attributes">attributes</Item>
    </Expand>
  </Type>

  <!-- Sender<C>: the element (as ElementRef) plus its resolved properties, like ((Button)sender). -->
  <Type Name="kubuno_views::events::sender::Sender&lt;*&gt;">
    <DisplayString>{inner}</DisplayString>
    <Expand>
      <ExpandedItem>inner</ExpandedItem>
      <Item Name="[Properties]">*props</Item>
    </Expand>
  </Type>

  <!-- ElementProps: the element's properties resolved against the view model, name = value. -->
  <Type Name="kubuno_views::events::sender::ElementProps">
    <DisplayString Condition="name.tag == name.variant0.DISCR_EXACT" Optional="true">{{ properties={values.len} }}</DisplayString>
    <DisplayString>{{ {name.variant1.value.__0} properties={values.len} }}</DisplayString>
    <Expand>
      <Item Name="Name">name</Item>
      <CustomListItems>
        <Variable Name="i" InitialValue="0" />
        <Variable Name="fields" InitialValue="(tuple$&lt;alloc::string::String,enum2$&lt;kubuno_views::binding::Value&gt; &gt; *)values.buf.inner.ptr.pointer.pointer" />
        <Size>values.len</Size>
        <Loop>
          <Break Condition="i == values.len" />
          <Item Name="{fields[i].__0,sb}">fields[i].__1</Item>
          <Exec>i = i + 1</Exec>
        </Loop>
      </CustomListItems>
    </Expand>
  </Type>

  <Type Name="kubuno_views::events::args::MouseEventArgs">
    <DisplayString>{{ Button={button} X={x,g} Y={y,g} Clicks={(int)clicks} }}</DisplayString>
    <Expand>
      <Item Name="Button">button</Item>
      <Item Name="Clicks">(int)clicks</Item>
      <Item Name="X">x</Item>
      <Item Name="Y">y</Item>
      <Item Name="Delta">delta</Item>
      <Item Name="Modifiers">mods</Item>
    </Expand>
  </Type>

  <Type Name="kubuno_views::events::args::Key">
    <DisplayString>{{ VK=0x{__0,xb} }}</DisplayString>
  </Type>

  <!-- Event<A>: the multicast event, subscribers counted like a .NET delegate's invocation list. -->
  <Type Name="kubuno_views::events::multicast::Event&lt;*&gt;">
    <DisplayString>{{ subscribers={slots.ptr.pointer->value.value.list.len} }}</DisplayString>
    <Expand>
      <Item Name="[subscribers]">slots.ptr.pointer->value.value.list</Item>
    </Expand>
  </Type>

  <Type Name="kubuno_views::events::typed::HandlerInfo">
    <DisplayString Condition="asynchronous">{name,sb} -> async {method,sb}</DisplayString>
    <DisplayString>{name,sb} -> {method,sb}</DisplayString>
  </Type>

  <!-- UiHandle<V>: a weak link to the view's UI context (async handlers). -->
  <Type Name="kubuno_views::events::executor::UiHandle&lt;*&gt;">
    <DisplayString Condition="ctx.ptr.pointer == (void*)-1 || ctx.ptr.pointer->strong.value.value == 0">UiHandle (view closed)</DisplayString>
    <DisplayString>UiHandle (view open)</DisplayString>
  </Type>

  <!-- ===== Standard-library types the toolchain's natvis leaves raw ===== -->

  <!-- Box<dyn Trait>: the vtable symbol names the concrete type (impl$<u8, core::any::Any>::vtable$ = a u8). -->
  <Type Name="alloc::boxed::Box&lt;dyn$&lt;*&gt;,*&gt;">
    <DisplayString>dyn {(void*)vtable,na}</DisplayString>
    <Expand>
      <Item Name="[data]">pointer</Item>
      <Item Name="[vtable]">vtable</Item>
    </Expand>
  </Type>

  <Type Name="std::path::PathBuf">
    <DisplayString>{inner}</DisplayString>
    <StringView>inner</StringView>
    <Expand>
      <ExpandedItem>inner</ExpandedItem>
    </Expand>
  </Type>

  <Type Name="std::sync::poison::mutex::Mutex&lt;*&gt;">
    <AlternativeType Name="std::sync::mutex::Mutex&lt;*&gt;" />
    <DisplayString Condition="poison.failed.v.__0 != 0" Optional="true">{data.value} (poisoned)</DisplayString>
    <DisplayString>{data.value}</DisplayString>
    <Expand>
      <Item Name="[poisoned]" Optional="true">poison.failed.v.__0 != 0</Item>
      <ExpandedItem>data.value</ExpandedItem>
    </Expand>
  </Type>

  <Type Name="std::sync::poison::rwlock::RwLock&lt;*&gt;">
    <AlternativeType Name="std::sync::rwlock::RwLock&lt;*&gt;" />
    <DisplayString>{data.value}</DisplayString>
    <Expand>
      <ExpandedItem>data.value</ExpandedItem>
    </Expand>
  </Type>

</AutoVisualizer>
