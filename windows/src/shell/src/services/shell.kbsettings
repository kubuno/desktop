<?xml version="1.0" encoding="utf-8"?>
<Settings Version="1">
  <Setting Name="Theme" Type="String" Default="System" Values="System|Light|Dark" Description="The colour theme of the shell's windows."/>
  <Setting Name="SyncIntervalMinutes" Type="Int" Default="5" Description="Minutes between two automatic sync cycles (1 to 120)."/>
  <Setting Name="Notifications" Type="Bool" Default="true" Description="Show a Windows toast when a sync finishes or fails."/>
  <Setting Name="Autostart" Type="Bool" Roaming="false" Default="false" Description="Start with Windows (mirrored into the Run key of this machine)."/>
  <Setting Name="FontFamily" Type="String" Description="Font family override; empty for the embedded face."/>
  <Setting Name="ActiveInstance" Type="String" Roaming="false" Description="The sync instance the launcher shows; empty for the first one."/>
</Settings>
