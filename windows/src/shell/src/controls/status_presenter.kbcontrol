<!--
  The three things a page says when it has no content: « loading » (a turning spinner over a caption),
  « nothing here » (the design system's empty state: a medallion, a title, a sentence) and « that failed »
  (a danger callout across the top). One of them shows, by Mode (Loading, Empty, Error); None shows nothing.
  Editorial choices of the shell, kept in one place for every page (labels, the console's sections).
-->
<UserControl xmlns="https://kubuno.com/views" xmlns:x="https://kubuno.com/views/x" xmlns:d="https://kubuno.com/views/design" x:Class="StatusPresenter" DesignWidth="600" DesignHeight="320" OnLoad="status_presenter_load">
  <Spinner x:Name="spinner" Size="Md" Visible="{Binding IsLoading}" d:Visible="false" X="284" Y="124" Width="32" Height="32" Anchor="None"/>
  <Label x:Name="loading_text" Text="{Res loading}" Role="Meta" ForeColor="TextTertiary" TextAlign="MiddleCenter" Visible="{Binding IsLoading}" d:Visible="false" X="0" Y="164" Width="600" Height="20" Anchor="Left, Right"/>
  <EmptyState x:Name="empty" Icon="{Binding EmptyIcon}" d:Icon="Inbox" Title="{Binding EmptyTitle}" d:Title="Rien pour l’instant" Description="{Binding EmptyText}" d:Description="Ce qui apparaîtra ici est décrit par cette phrase." Visible="{Binding IsEmpty}" X="0" Y="0" Width="600" Height="320" Anchor="Top, Bottom, Left, Right"/>
  <Callout x:Name="error" Body="{Binding ErrorText}" Variant="Danger" Visible="{Binding IsError}" d:Visible="false" X="0" Y="0" Width="600" Height="52" Anchor="Top, Left, Right" MaximumSize="720, 0"/>
</UserControl>
