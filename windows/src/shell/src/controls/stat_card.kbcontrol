<!--
  One figure of the console's dashboard (the web's stat card): a dense card titled by what is counted, its
  glyph at the end of the title, the figure, and under it a line (« +3 cette semaine ») or a bar (the share
  of active accounts).
-->
<UserControl xmlns="https://kubuno.com/views" xmlns:x="https://kubuno.com/views/x" xmlns:d="https://kubuno.com/views/design" x:Class="StatCard" DesignWidth="222" DesignHeight="117" OnLoad="stat_card_load">
  <Card x:Name="card" Title="{Binding Label}" Dense="true" Surface="Layer" Dock="Fill">
    <Panel x:Name="body" Width="196" Height="54">
      <Label x:Name="figure" Text="{Binding Value}" d:Text="248" Role="Title" TextAlign="MiddleLeft" X="0" Y="0" Width="196" Height="30" Anchor="Top, Left, Right"/>
      <Label x:Name="sub" Text="{Binding Sub}" d:Text="+6 cette semaine" Role="Meta" ForeColor="TextTertiary" TextAlign="MiddleLeft" Visible="{Binding HasSub}" X="0" Y="38" Width="196" Height="16" Anchor="Top, Left, Right"/>
      <ProgressBar x:Name="bar" Value="{Binding Share}" Maximum="10000" Variant="Success" Size="Sm" Visible="{Binding HasBar}" d:Visible="false" X="0" Y="42" Width="196" Height="8" Anchor="Top, Left, Right"/>
    </Panel>
  </Card>
  <Icon x:Name="glyph" Name="{Binding Glyph}" d:Name="Users" Size="18" ForeColor="TextTertiary" X="192" Y="10" Width="18" Height="18" Anchor="Top, Right"/>
</UserControl>
