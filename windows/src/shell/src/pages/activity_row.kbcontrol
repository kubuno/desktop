<!--
  One event of the activity page (the item template of its Repeater): the kind carries the meaning, so
  it carries the colour — a cloud glyph tinted green, amber or red — then the title over the details,
  and the age right-aligned so the ages line up as a column.
-->
<UserControl xmlns="https://kubuno.com/views" xmlns:x="https://kubuno.com/views/x" xmlns:d="https://kubuno.com/views/design" x:Class="ActivityRow" DesignWidth="888" DesignHeight="56">
  <Icon x:Name="kind" Name="Cloud" Size="18" ForeColor="{Binding Tone}" d:ForeColor="Success" AccessibleName="{Binding Title}" X="8" Y="18" Width="20" Height="20"/>
  <Label x:Name="title" Text="{Binding Title}" d:Text="Synchronisation terminée" TextAlign="MiddleLeft" X="40" Y="8" Width="738" Height="22" Anchor="Top, Left, Right"/>
  <Label x:Name="body" Text="{Binding Body}" d:Text="↑ 3 envoyé(s), 1 modifié(s) — ↓ 12 reçu(s), 0 supprimé(s)" Role="Meta" ForeColor="TextSecondary" TextAlign="MiddleLeft" X="40" Y="30" Width="738" Height="26" Anchor="Top, Left, Right"/>
  <Label x:Name="age" Text="{Binding Age}" d:Text="à l’instant" Role="Meta" ForeColor="TextTertiary" TextAlign="MiddleRight" X="778" Y="0" Width="102" Height="56" Anchor="Top, Right"/>
</UserControl>
