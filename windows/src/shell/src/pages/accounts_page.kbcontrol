<!--
  The accounts page: which instance the launcher shows, and the way in and out of a multi-instance
  setup. One AccountRow per configured instance (a Repeater; a click on a row makes it the current one),
  then « Ajouter un compte ». Everything is raised as AccountCommand (select, move, disconnect, add) with
  the instance's id; the window carries it out.
-->
<UserControl xmlns="https://kubuno.com/views" xmlns:x="https://kubuno.com/views/x" xmlns:d="https://kubuno.com/views/design" x:Class="AccountsPage" DesignWidth="984" DesignHeight="736" BackColor="Background">
  <Label x:Name="title" Text="{Res accounts_title}" Role="Page" TextAlign="MiddleLeft" X="24" Y="0" Width="936" Height="64" Anchor="Top, Left, Right"/>
  <Card x:Name="card" X="24" Y="64" Width="936" Height="648" Anchor="Top, Bottom, Left, Right">
    <Stack x:Name="column" Direction="TopDown" Gap="8" Padding="7">
      <Repeater x:Name="list" ItemsSource="{Binding Rows}" ItemKey="Id" ItemHeight="56" Spacing="8" SelectionMode="Single" SelectedIndex="{Binding ActiveIndex}" DesignItemCount="2" d:ItemsSource='[{"Id":"sample-cloud","ActiveId":"sample-cloud","Title":"Camille Martin — cloud.exemple.fr","Folder":"C:\\Users\\Camille\\Kubuno"},{"Id":"sample-asso","ActiveId":"sample-cloud","Title":"Camille M. — Association — kubuno.asso-exemple.org","Folder":"D:\\Association\\Kubuno"}]' OnItemClick="list_item_click">
        <AccountRow AccountId="{Binding Id}" ActiveId="{Binding ActiveId}" Title="{Binding Title}" Folder="{Binding Folder}" OnMoveRequested="row_move_requested" OnDisconnectRequested="row_disconnect_requested"/>
      </Repeater>
      <Panel x:Name="add_row" Height="36">
        <Button x:Name="add" Text="{Res add_account}" Variant="Secondary" X="0" Y="0" Width="200" Height="36" OnClick="add_click"/>
      </Panel>
    </Stack>
  </Card>
</UserControl>
