<!--
  Kubuno Desktop's window. The 64-DIP header IS the title bar: the menu button and the brand on the
  left, and on the right the search, the storage gauge, the bell and its counter, settings, help, the
  apps waffle and the account avatar (title-bar regions; the gaps between them drag the window, the
  controls do not). Under it the rail (the pages, and the console's tree while it is open, with the
  connection state at its foot) and the page the rail selects, one user control each.
  ShellWindow (shell_window.rs) keeps the data and fills the pages through typed access.
-->
<Panel xmlns="https://kubuno.com/views" xmlns:x="https://kubuno.com/views/x" xmlns:d="https://kubuno.com/views/design" DesignWidth="1180" DesignHeight="736" Title="{Res app_title}" Icon="{Res app_icon}" Backdrop="MicaAlt"
       TitleBarStyle="Tall" TitleBarPadding="8" TitleBarBackground="Background" TitleBarForeground="TextPrimary"
       CaptionButtonStyle="Windows" CornerPreference="Round" SizeGripStyle="Hide" ShowIcon="false" ShowTitle="false" BackColor="Background" MinimumSize="420, 320"
       OnLoad="shell_window_load" OnShown="shell_window_shown" OnResize="shell_window_resize"
       KeyPreview="true" OnKeyDown="shell_window_key_down"
       OnFormClosing="shell_window_form_closing" OnFormClosed="shell_window_form_closed">
  <IconButton x:Name="menu_button" TitleBar.Region="Left" Icon="Menu" Diameter="40" Glyph="20" ToolTip="{Res menu_tip}" Width="40" Height="40"/>
  <Panel x:Name="brand" TitleBar.Region="Left" TitleBar.Drag="true" Width="204" Height="64">
    <Icon x:Name="brand_mark" Name="Cloud" Size="22" IconColor="Primary" X="4" Y="21" Width="22" Height="22"/>
    <Label x:Name="brand_name" Text="{Res brand_name}" Role="Title" Visible="{Binding HeaderWide}" ForeColor="TextSecondary" TextAlign="MiddleLeft" X="32" Y="0" Width="172" Height="64"/>
  </Panel>
  <Panel x:Name="header_actions" TitleBar.Region="Right" Width="460" Height="64">
    <IconButton x:Name="search_button" Icon="OmnibarSearch" ToolTip="{Res search_tip}" X="0" Y="14" Width="36" Height="36" Anchor="Top, Right"/>
    <StorageGauge x:Name="storage_gauge" ToolTip="{Res storage_tip}" Visible="{Binding ShowGauge}" X="36" Y="14" Width="240" Height="36" Anchor="Top, Right" OnClick="storage_gauge_click"/>
    <IconButton x:Name="bell_button" Icon="Bell" ToolTip="{Res notifications_tip}" X="280" Y="14" Width="36" Height="36" Anchor="Top, Right" OnClick="bell_button_click"/>
    <Badge x:Name="bell_badge" Text="{Binding UnreadText}" d:Text="5" Variant="Danger" Solid="true" Visible="{Binding HasUnread}" X="294" Y="20" Width="16" Height="16" Anchor="Top, Right"/>
    <IconButton x:Name="settings_button" Icon="Settings" ToolTip="{Res settings_tip}" X="316" Y="14" Width="36" Height="36" Anchor="Top, Right" OnClick="settings_button_click"/>
    <IconButton x:Name="help_button" Icon="HelpCircle" ToolTip="{Res help_tip}" X="352" Y="14" Width="36" Height="36" Anchor="Top, Right"/>
    <WaffleButton x:Name="apps_button" PopupAnchor="Window" PopupOffset="68" PopupMargin="8" PopupBottomGap="12" X="388" Y="14" Width="36" Height="36" Anchor="Top, Right"/>
    <AccountButton x:Name="account_avatar" UserName="{Binding UserName}" Initials="{Binding Initials}" AvatarPath="{Binding AvatarPath}" PopupAnchor="Window" PopupOffset="54" PopupMargin="8" PopupBottomGap="16" X="424" Y="14" Width="36" Height="36" Anchor="Top, Right"/>
  </Panel>
  <Panel x:Name="rail" Dock="Left" Width="196" BackColor="Surface" Visible="{Binding RailVisible}">
    <Separator x:Name="rail_rule" Orientation="Vertical" Dock="Right" Width="1"/>
    <Panel x:Name="connection" Dock="Bottom" Height="52">
      <StatusDot x:Name="connection_dot" Color="{Binding ConnectionColor}" d:Color="Success" Diameter="8" X="20" Y="18" Width="8" Height="8"/>
      <Label x:Name="connection_label" Text="{Binding ConnectionText}" d:Text="{Res conn_online}" Role="Meta" ForeColor="TextSecondary" TextAlign="MiddleLeft" Visible="{Binding RailExpanded}" X="36" Y="0" Width="152" Height="44" Anchor="Top, Left, Right"/>
    </Panel>
    <Panel x:Name="rail_top_gap" Dock="Top" Height="8"/>
    <Sidebar x:Name="nav" AccessibleName="{Res nav_name}" Dock="Fill" ItemsSource="{Binding NavRows}" SelectedItem="{Binding NavKey}" DisplayMode="{Binding NavMode}" OnItemInvoked="nav_item_invoked">
      <!-- The rows of the pages (NavRows at run time, which adds the console's tree under them while it is
           open). Every row keeps the tree's chevron column free in front of its icon (Indent), so the pages
           and the console's groups line up. -->
      <SidebarItem x:Name="nav_launcher" Key="launcher" Text="{Res nav_home}" Icon="Home" Indent="28"/>
      <SidebarItem x:Name="nav_activity" Key="activity" Text="{Res nav_activity}" Icon="History" Indent="28"/>
      <SidebarItem x:Name="nav_accounts" Key="accounts" Text="{Res nav_accounts}" Icon="Users" Indent="28"/>
      <SidebarItem x:Name="nav_settings" Key="settings" Text="{Res nav_settings}" Icon="Settings" Indent="28"/>
    </Sidebar>
  </Panel>
  <LauncherPage x:Name="launcher_page" Dock="Fill" Visible="{Binding OnLauncher}" d:Visible="true" OnCommand="launcher_page_command"/>
  <SettingsPage x:Name="settings_page" Dock="Fill" Visible="{Binding OnSettings}" d:Visible="false" OnSettingChanged="settings_page_setting_changed"/>
  <AccountsPage x:Name="accounts_page" Dock="Fill" Visible="{Binding OnAccounts}" d:Visible="false" OnAccountCommand="accounts_page_account_command"/>
  <ActivityPage x:Name="activity_page" Dock="Fill" Visible="{Binding OnActivity}" d:Visible="false"/>
  <LoginPage x:Name="login_page" Dock="Fill" Visible="{Binding OnLogin}" d:Visible="false" OnCommand="login_page_command"/>
  <LabelsPage x:Name="labels_page" Dock="Fill" Visible="{Binding OnLabels}" d:Visible="false" OnLabelCommand="labels_page_label_command"/>
  <AdminPage x:Name="admin_page" Dock="Fill" Visible="{Binding OnAdmin}" d:Visible="false" OnCommand="admin_page_command"/>
  <!-- The activity's ages (« il y a 5 min ») move on with the clock. -->
  <Timer x:Name="clock" Interval="30000" Enabled="true" OnTick="clock_tick"/>
</Panel>
