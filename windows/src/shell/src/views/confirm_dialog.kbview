<!--
  The confirmation asked before something destructive (deleting a label, disconnecting an account,
  signing out): an in-window dialog over a veil, as the shell always showed it — the page underneath
  takes no input until it closes. The glyph on its disc says how serious it is (danger, warning), the
  message says what will happen, and the confirming action says it again (« Supprimer », « Déconnecter »).
  Enter confirms, Escape and « Annuler » cancel. ConfirmDialog (confirm_dialog.rs) fills it in.
-->
<Panel xmlns="https://kubuno.com/views" xmlns:x="https://kubuno.com/views/x" DesignWidth="440" DesignHeight="138" WindowKind="Dialog" Title="Supprimer l'étiquette" AcceptButton="confirm" CancelButton="cancel">
  <Icon x:Name="glyph" Name="Trash2" Disc="Danger" Size="40" X="24" Y="24" Width="40" Height="40"/>
  <Label x:Name="message" Text="« Projet Atlas » sera retirée de tous les éléments qui la portent." Overflow="Wrap" TextAlign="TopLeft" X="80" Y="24" Width="336" Height="90" Anchor="Top, Bottom, Left, Right"/>
  <Button x:Name="cancel" ActionBar.Region="Right" Text="{Res cancel}" Variant="Secondary" Width="104" Height="36" OnClick="cancel_click"/>
  <Button x:Name="confirm" ActionBar.Region="Right" Text="Supprimer" Variant="Danger" Width="120" Height="36" OnClick="confirm_click"/>
</Panel>
