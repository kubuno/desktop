<!--
  Signing out while changes were not sent yet (vskubuno docs/DESKTOP-OFFLINE-SYNC.md section 10): an in-window
  dialog over a veil, like the confirmation. « Envoyer d'abord » is the default (Enter): the changes are sent,
  then the account is signed out if nothing is left; « Exporter » copies the files of the changes into a folder
  first; « Supprimer quand même » signs out at once. Escape and « Annuler » keep the account.
  SignOutDialog (signout_dialog.rs) fills it in.
-->
<Panel xmlns="https://kubuno.com/views" xmlns:x="https://kubuno.com/views/x" DesignWidth="600" DesignHeight="120" WindowKind="Dialog" Title="Modifications non envoyées" AcceptButton="send" CancelButton="cancel">
  <Icon x:Name="glyph" Name="AlertTriangle" Disc="Warning" Size="40" X="24" Y="24" Width="40" Height="40"/>
  <Label x:Name="message" Text="3 modification(s) de « cloud.exemple.fr » n'ont pas encore été envoyées au serveur. Les envoyer avant de vous déconnecter ?" Overflow="Wrap" TextAlign="TopLeft" X="80" Y="24" Width="496" Height="72" Anchor="Top, Bottom, Left, Right"/>
  <Button x:Name="discard" ActionBar.Region="Left" Text="{Res signout_discard}" Variant="Danger" Width="176" Height="36" OnClick="discard_click"/>
  <Button x:Name="cancel" ActionBar.Region="Right" Text="{Res cancel}" Variant="Secondary" Width="96" Height="36" OnClick="cancel_click"/>
  <Button x:Name="export" ActionBar.Region="Right" Text="{Res signout_export}" Variant="Secondary" Width="104" Height="36" OnClick="export_click"/>
  <Button x:Name="send" ActionBar.Region="Right" Text="{Res signout_send}" Variant="Primary" Width="144" Height="36" OnClick="send_click"/>
</Panel>
