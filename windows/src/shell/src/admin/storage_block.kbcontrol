<!--
  One card of the console's storage page, an item of its Repeater, in one of four kinds. The overview: the space
  the accounts use against the volume (a composition bar of accounts, other content and free space), the volume's
  path, the accounts and the space allocated to them. The accounts' states: a bar of those within, near and at
  their quota, and what it means. The split by organisational unit, and by category (billed or not): one row each,
  a bar of its size against the largest.
-->
<UserControl xmlns="https://kubuno.com/views" xmlns:x="https://kubuno.com/views/x" xmlns:d="https://kubuno.com/views/design" x:Class="StorageBlock" DesignWidth="936" DesignHeight="203" OnLoad="storage_block_load">
  <Card x:Name="card" Title="{Binding BlockTitle}" d:Title="Aperçu" Subtitle="{Binding BlockSubtitle}" Surface="Layer" Dock="Fill">
    <Panel x:Name="body" Dock="Fill" Width="902" Height="138">
      <Stack x:Name="hero" Direction="LeftToRight" Gap="8" CrossAlign="End" Visible="{Binding IsOverview}" X="0" Y="0" Width="902" Height="34" Anchor="Top, Left, Right">
        <Label x:Name="used" Text="{Binding Hero}" d:Text="812.00 Go" Role="Title" AutoSize="true" TextAlign="MiddleLeft" Height="34"/>
        <Label x:Name="volume" Text="{Binding HeroOf}" d:Text="sur 4000.00 Go" ForeColor="TextSecondary" AutoSize="true" TextAlign="BottomLeft" Height="30"/>
      </Stack>
      <StackedBar x:Name="volume_bar" AccessibleName="{Binding VolumeName}" Segments="{Binding VolumeSegments}" Total="{Binding VolumeTotal}" Visible="{Binding HasVolume}" X="0" Y="46" Width="902" Height="8" Anchor="Top, Left, Right"/>
      <Label x:Name="path" Text="{Binding VolumePath}" d:Text="/var/lib/kubuno" Role="Meta" ForeColor="TextTertiary" TextAlign="MiddleLeft" Visible="{Binding IsOverview}" X="0" Y="60" Width="902" Height="18" Anchor="Top, Left, Right"/>
      <Separator x:Name="figures_rule" Orientation="Horizontal" Visible="{Binding IsOverview}" X="0" Y="86" Width="902" Height="1" Anchor="Top, Left, Right"/>
      <Label x:Name="accounts_label" Text="{Res storage_accounts}" Role="Meta" ForeColor="TextSecondary" Visible="{Binding IsOverview}" X="0" Y="98" Width="440" Height="16"/>
      <Label x:Name="accounts" Text="{Binding Accounts}" d:Text="248" Font="Segoe UI Variable Text, 10pt, style=Bold" Visible="{Binding IsOverview}" X="0" Y="114" Width="440" Height="24"/>
      <Label x:Name="allocated_label" Text="{Res storage_allocated}" Role="Meta" ForeColor="TextSecondary" Visible="{Binding IsOverview}" X="451" Y="98" Width="440" Height="16" Anchor="Top, Left, Right"/>
      <Label x:Name="allocated" Text="{Binding Allocated}" d:Text="2480.00 Go" Font="Segoe UI Variable Text, 10pt, style=Bold" Visible="{Binding IsOverview}" X="451" Y="114" Width="440" Height="24" Anchor="Top, Left, Right"/>
      <StackedBar x:Name="states_bar" AccessibleName="{Binding StatesText}" Segments="{Binding StateSegments}" Total="{Binding StateTotal}" Visible="{Binding IsStates}" d:Visible="false" X="0" Y="2" Width="902" Height="8" Anchor="Top, Left, Right"/>
      <Label x:Name="states_text" Text="{Binding StatesText}" ForeColor="TextSecondary" TextAlign="MiddleLeft" Visible="{Binding IsStates}" d:Visible="false" X="0" Y="24" Width="902" Height="24" Anchor="Top, Left, Right"/>
      <Repeater x:Name="units" ItemsSource="{Binding Units}" ItemHeight="44" Visible="{Binding IsUnits}" d:Visible="false" X="0" Y="0" Width="902" Height="138" Anchor="Top, Bottom, Left, Right">
        <Panel Height="44">
          <Stack Direction="LeftToRight" Gap="2" CrossAlign="End" X="0" Y="0" Width="790" Height="18" Anchor="Top, Left, Right">
            <Label Text="{Binding Name}" AutoSize="true" TextAlign="MiddleLeft" Height="18"/>
            <Label Text="{Binding Accounts}" Role="Meta" ForeColor="TextTertiary" AutoSize="true" TextAlign="BottomLeft" Height="17"/>
          </Stack>
          <Label Text="{Binding Size}" ForeColor="TextSecondary" TextAlign="MiddleCenter" X="802" Y="0" Width="100" Height="18" Anchor="Top, Right"/>
          <ProgressBar Value="{Binding Share}" Maximum="10000" Variant="Primary" X="0" Y="24" Width="902" Height="8" Anchor="Top, Left, Right"/>
        </Panel>
      </Repeater>
      <Repeater x:Name="categories" ItemsSource="{Binding Categories}" ItemHeight="54" EmptyText="{Res storage_no_category}" Visible="{Binding IsCategories}" d:Visible="false" X="0" Y="0" Width="902" Height="138" Anchor="Top, Bottom, Left, Right">
        <Panel Height="54">
          <Label Text="{Binding Name}" TextAlign="MiddleLeft" X="0" Y="8" Width="190" Height="18"/>
          <Badge Text="{Res storage_billed}" Variant="Primary" Size="Sm" Visible="{Binding Billed}" X="0" Y="30" Width="90" Height="18"/>
          <Badge Text="{Res storage_not_billed}" Size="Sm" Visible="{Binding NotBilled}" X="0" Y="30" Width="100" Height="18"/>
          <ProgressBar Value="{Binding Share}" Maximum="10000" Variant="Primary" X="206" Y="23" Width="434" Height="8" Anchor="Top, Left, Right"/>
          <Label Text="{Binding Objects}" Role="Meta" ForeColor="TextTertiary" TextAlign="MiddleCenter" X="672" Y="0" Width="130" Height="54" Anchor="Top, Right"/>
          <Label Text="{Binding Size}" TextAlign="MiddleCenter" X="802" Y="0" Width="100" Height="54" Anchor="Top, Right"/>
          <Separator Orientation="Horizontal" Visible="{Binding Ruled}" X="0" Y="53" Width="902" Height="1" Anchor="Top, Left, Right"/>
        </Panel>
      </Repeater>
    </Panel>
  </Card>
</UserControl>
