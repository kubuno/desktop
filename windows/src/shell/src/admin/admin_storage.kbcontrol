<!--
  The console's « Stockage » section, read only: what the accounts use against what the volume holds. Four
  cards (StorageBlock), each as tall as its content (a Repeater whose rows name their height): the overview,
  the accounts' states against the instance's threshold, the split by organisational unit, and by category.
-->
<UserControl xmlns="https://kubuno.com/views" xmlns:x="https://kubuno.com/views/x" xmlns:d="https://kubuno.com/views/design" x:Class="StorageSection" DesignWidth="936" DesignHeight="688" OnLoad="storage_section_load">
  <AdminSectionHeader x:Name="header" Title="{Res adm_storage}" Intro="{Res storage_intro}" X="0" Y="0" Width="936" Height="86" Anchor="Top, Left, Right"/>
  <StatusPresenter x:Name="status" Mode="{Binding StatusMode}" d:Visible="false" EmptyIcon="HardDrive" EmptyTitle="{Res storage_empty_title}" EmptyText="{Res storage_empty_text}" ErrorText="{Binding ErrorText}" X="0" Y="98" Width="936" Height="590" Anchor="Top, Bottom, Left, Right"/>
  <Repeater x:Name="blocks" ItemsSource="{Binding Blocks}" ItemKey="Kind" ItemHeightField="Height" Spacing="12" d:ItemsSource="design/storage_blocks.json" X="0" Y="98" Width="936" Height="590" Anchor="Top, Bottom, Left, Right">
    <StorageBlock AccessibleName="{Binding Title}" Kind="{Binding Kind}" BlockTitle="{Binding Title}" BlockSubtitle="{Binding Subtitle}" Hero="{Binding Hero}" HeroOf="{Binding HeroOf}" VolumeSegments="{Binding VolumeSegments}" VolumeTotal="{Binding VolumeTotal}" VolumePath="{Binding VolumePath}" Accounts="{Binding Accounts}" Allocated="{Binding Allocated}" StateSegments="{Binding StateSegments}" StateTotal="{Binding StateTotal}" StatesText="{Binding StatesText}" Units="{Binding Units}" Categories="{Binding Categories}"/>
  </Repeater>
</UserControl>
