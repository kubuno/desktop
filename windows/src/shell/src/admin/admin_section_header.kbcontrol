<!--
  How every section of the administration console opens (the web's console page header): a breadcrumb
  (« Annuaire › Utilisateurs »), the section's title at the console's page size, an inline count after it
  (« 5 groupes ») and, for some, one line of introduction. A part left empty takes no room. A section's own
  button (« Nouveau groupe ») sits on the title's line, in the section's view.
-->
<UserControl xmlns="https://kubuno.com/views" xmlns:x="https://kubuno.com/views/x" xmlns:d="https://kubuno.com/views/design" x:Class="AdminSectionHeader" DesignWidth="900" DesignHeight="86" OnLoad="admin_section_header_load">
  <Stack x:Name="lines" Direction="TopDown" Gap="0" Dock="Fill">
    <Breadcrumb x:Name="trail" Visible="{Binding HasTrail}" Height="20">
      <BreadcrumbItem Text="{Binding Parent}"/>
      <BreadcrumbItem Text="{Binding Title}"/>
    </Breadcrumb>
    <Stack x:Name="title_line" Direction="LeftToRight" Gap="12" Height="40">
      <Label x:Name="title_label" Text="{Binding Title}" d:Text="Utilisateurs" Role="PageAdmin" AutoSize="true" TextAlign="MiddleLeft" Height="40"/>
      <Label x:Name="count_label" Text="{Binding Count}" d:Text="248 utilisateurs" ForeColor="TextSecondary" Visible="{Binding HasCount}" AutoSize="true" TextAlign="BottomLeft" Height="35"/>
    </Stack>
    <Label x:Name="intro_label" Text="{Binding Intro}" d:Text="Une ligne d'introduction." ForeColor="TextSecondary" TextAlign="BottomLeft" Visible="{Binding HasIntro}" Height="26"/>
  </Stack>
</UserControl>
