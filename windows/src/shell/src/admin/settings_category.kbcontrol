<!--
  One category of the instance's settings (« Courriel », « Général »…): a dense card titled by the category,
  one row per setting — its label, its current value on the right, its description under the label — the rows
  separated by rules. Read only.
-->
<UserControl xmlns="https://kubuno.com/views" xmlns:x="https://kubuno.com/views/x" xmlns:d="https://kubuno.com/views/design" x:Class="SettingsCategory" DesignWidth="936" DesignHeight="175" OnLoad="settings_category_load">
  <Card x:Name="card" Title="{Binding CategoryTitle}" d:Title="Général" Dense="true" Surface="Layer" Dock="Fill">
    <Repeater x:Name="rows" ItemsSource="{Binding Settings}" ItemHeight="56" d:ItemsSource="design/setting_rows.json" Width="910" Height="112">
      <Panel Height="56">
        <Label Text="{Binding Label}" d:Text="Langue par défaut" TextAlign="MiddleLeft" X="0" Y="8" Width="690" Height="22" Anchor="Top, Left, Right"/>
        <Label Text="{Binding Value}" d:Text="fr" ForeColor="TextSecondary" TextAlign="MiddleCenter" X="710" Y="8" Width="200" Height="22" Anchor="Top, Right"/>
        <Label Text="{Binding Description}" d:Text="Pour les nouveaux comptes" Role="Meta" ForeColor="TextTertiary" TextAlign="MiddleLeft" X="0" Y="30" Width="690" Height="18" Anchor="Top, Left, Right"/>
        <Separator Orientation="Horizontal" Visible="{Binding Ruled}" X="0" Y="55" Width="910" Height="1" Anchor="Top, Left, Right"/>
      </Panel>
    </Repeater>
  </Card>
</UserControl>
