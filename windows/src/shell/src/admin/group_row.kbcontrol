<!--
  One item of the console's groups (the web's GroupsPanel row), the item template of its Repeater, in one of
  two kinds. A header: the chevron that shows the group's details, its name with its « Par défaut » and
  « Système » badges, its description, how many members it has and the pencil that edits it in the web
  console. Its details, the item that follows an expanded header: its permissions as badges, and when it was
  created.
-->
<UserControl xmlns="https://kubuno.com/views" xmlns:x="https://kubuno.com/views/x" xmlns:d="https://kubuno.com/views/design" x:Class="GroupRow" DesignWidth="936" DesignHeight="64" OnLoad="group_row_load">
  <IconButton x:Name="chevron" Icon="{Binding ChevronIcon}" d:Icon="ChevronRight" Diameter="28" Glyph="16" ToolTip="{Res groups_details_tip}" Visible="{Binding IsHeader}" X="2" Y="18" Width="28" Height="28" OnClick="chevron_click"/>
  <Stack x:Name="name_line" Direction="LeftToRight" Gap="8" CrossAlign="Center" Visible="{Binding IsHeader}" X="36" Y="10" Width="740" Height="22">
    <Label x:Name="name" Text="{Binding GroupName}" d:Text="Utilisateurs" AutoSize="true" Font="Segoe UI Variable Text, 10pt, style=Bold" TextAlign="MiddleLeft" Height="22"/>
    <Badge x:Name="default_badge" Text="{Res groups_default}" Variant="Primary" Size="Sm" Visible="{Binding IsDefault}"/>
    <Badge x:Name="system_badge" Text="{Res groups_system}" Size="Sm" Visible="{Binding IsSystem}" d:Visible="false"/>
  </Stack>
  <Label x:Name="description" Text="{Binding Description}" d:Text="Tous les comptes créés" Role="Meta" ForeColor="TextTertiary" TextAlign="MiddleLeft" Visible="{Binding IsHeader}" X="36" Y="32" Width="750" Height="22" Anchor="Top, Left, Right"/>
  <Label x:Name="members" Text="{Binding CountText}" d:Text="240 membres" Role="Meta" ForeColor="TextTertiary" TextAlign="MiddleCenter" Visible="{Binding IsHeader}" X="786" Y="22" Width="106" Height="20" Anchor="Top, Right"/>
  <IconButton x:Name="edit" Icon="PenLine" Diameter="28" Glyph="15" ToolTip="{Res groups_edit_tip}" Visible="{Binding IsHeader}" X="900" Y="18" Width="28" Height="28" Anchor="Top, Right" OnClick="edit_click"/>
  <Label x:Name="permissions_label" Text="{Res groups_permissions}" Role="Meta" Font="Segoe UI Variable Small, 8.5pt, style=Bold" ForeColor="TextSecondary" TextAlign="MiddleLeft" Visible="{Binding IsDetails}" d:Visible="false" X="36" Y="0" Width="300" Height="18"/>
  <Label x:Name="created" Text="{Binding CreatedText}" Role="Meta" ForeColor="TextTertiary" TextAlign="MiddleRight" Visible="{Binding IsDetails}" d:Visible="false" X="586" Y="0" Width="342" Height="18" Anchor="Top, Right"/>
  <Repeater x:Name="permissions" ItemsSource="{Binding Permissions}" Orientation="Horizontal" Spacing="8" EmptyText="{Res groups_no_permission}" Visible="{Binding IsDetails}" d:Visible="false" X="36" Y="22" Width="892" Height="24" Anchor="Top, Left, Right">
    <Badge Text="{Binding Label}" Variant="Primary" Dot="true"/>
  </Repeater>
  <Separator x:Name="rule" Orientation="Horizontal" X="0" Y="63" Width="936" Height="1" Anchor="Top, Left, Right"/>
</UserControl>
