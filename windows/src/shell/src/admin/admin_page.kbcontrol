<!--
  The administration console: one section at a time (the rail's tree picks it), each a user control showing
  what the console page hands it (its loaded data, or that it loads, or why it failed). A section the desktop
  does not show natively says so and offers the web console. What a section asks for (another page of a
  list, a module switched on) is raised as Command with the section's id; the window carries it out.
-->
<UserControl xmlns="https://kubuno.com/views" xmlns:x="https://kubuno.com/views/x" xmlns:d="https://kubuno.com/views/design" x:Class="AdminPage" DesignWidth="984" DesignHeight="736" BackColor="Background" OnLoad="admin_page_load">
  <Panel x:Name="body" Dock="Fill" Width="984" Height="736">
    <DashboardSection x:Name="dashboard" State="{Binding Dashboard}" Visible="{Binding OnDashboard}" X="24" Y="24" Width="936" Height="688" Anchor="Top, Bottom, Left, Right" OnCommand="section_command"/>
    <UsersSection x:Name="users" State="{Binding Users}" Visible="{Binding OnUsers}" d:Visible="false" X="24" Y="24" Width="936" Height="688" Anchor="Top, Bottom, Left, Right" OnCommand="section_command"/>
    <StorageSection x:Name="storage" State="{Binding Storage}" Visible="{Binding OnStorage}" d:Visible="false" X="24" Y="24" Width="936" Height="688" Anchor="Top, Bottom, Left, Right" OnCommand="section_command"/>
    <InstanceSettingsSection x:Name="settings" State="{Binding Settings}" Visible="{Binding OnSettings}" d:Visible="false" X="24" Y="24" Width="936" Height="688" Anchor="Top, Bottom, Left, Right" OnCommand="section_command"/>
    <ModulesSection x:Name="modules" State="{Binding Modules}" Visible="{Binding OnModules}" d:Visible="false" X="24" Y="24" Width="936" Height="688" Anchor="Top, Bottom, Left, Right" OnCommand="section_command"/>
    <OrgUnitsSection x:Name="org_units" State="{Binding OrgUnits}" Visible="{Binding OnOrgUnits}" d:Visible="false" X="24" Y="24" Width="936" Height="688" Anchor="Top, Bottom, Left, Right" OnCommand="section_command"/>
    <AudiencesSection x:Name="audiences" State="{Binding Audiences}" Visible="{Binding OnAudiences}" d:Visible="false" X="24" Y="24" Width="936" Height="688" Anchor="Top, Bottom, Left, Right" OnCommand="section_command"/>
    <GroupsSection x:Name="groups" State="{Binding Groups}" Visible="{Binding OnGroups}" d:Visible="false" X="24" Y="24" Width="936" Height="688" Anchor="Top, Bottom, Left, Right" OnCommand="section_command"/>
    <EmptyState x:Name="not_ported" Icon="AppWindow" Title="{Binding SectionTitle}" d:Title="Accueil" Description="{Res adm_not_ported}" SecondaryActionLabel="{Res adm_open_web}" Visible="{Binding NotPorted}" d:Visible="false" X="24" Y="24" Width="936" Height="688" Anchor="Top, Bottom, Left, Right" OnSecondaryAction="not_ported_action"/>
  </Panel>
</UserControl>
