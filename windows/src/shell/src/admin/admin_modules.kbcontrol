<!--
  The installed modules (the web's ModulesPanel): how many there are and « Marketplace » (the web console) on the
  title's line, a filter, then the table — the module (its logo, its name, its version, « Par défaut » on the one
  the instance opens on, its description), whether its service is on for everyone (a dot and the words), and a ⋮
  that switches it on or off for everyone.
-->
<UserControl xmlns="https://kubuno.com/views" xmlns:x="https://kubuno.com/views/x" xmlns:d="https://kubuno.com/views/design" x:Class="ModulesSection" DesignWidth="936" DesignHeight="688" OnLoad="modules_section_load">
  <AdminSectionHeader x:Name="header" Parent="{Res adm_apps}" Title="{Res adm_modules}" Count="{Binding CountText}" X="0" Y="0" Width="760" Height="60" Anchor="Top, Left, Right"/>
  <Button x:Name="marketplace" Text="{Res modules_marketplace}" Icon="LayoutGrid" Variant="Secondary" X="782" Y="22" Width="154" Height="36" Anchor="Top, Right" OnClick="marketplace_click"/>
  <SearchField x:Name="filter" Placeholder="{Res modules_filter}" X="0" Y="76" Width="360" Height="32" OnTextChanged="filter_text_changed"/>
  <DataTable x:Name="table" AccessibleName="{Res adm_modules}" ItemsSource="{Binding Rows}" d:ItemsSource="design/modules.json" ReadOnly="true" OwnerDraw="true" Density="Comfortable" SortColumn="Name" SortOrder="Ascending" Loading="{Binding Loading}" ErrorText="{Binding ErrorText}" EmptyTitle="{Res modules_empty_title}" EmptyText="{Res modules_empty_text}" X="0" Y="124" Width="936" Height="564" Anchor="Top, Bottom, Left, Right" OnDrawItem="table_draw_item" OnCellClick="table_cell_click">
    <Column Header="{Res modules_col_app}" Binding="{Binding Name}" Width="240" AutoSizeMode="Fill"/>
    <Column Header="{Res modules_col_status}" Binding="{Binding Status}" Width="260"/>
    <Column Header="" Binding="{Binding Id}" Width="44"/>
  </DataTable>
</UserControl>
