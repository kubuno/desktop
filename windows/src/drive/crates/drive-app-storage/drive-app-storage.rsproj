<Project Sdk="Kubuno.Rust.Sdk/1.1.1">

  <!-- Generated by "Kubuno: Generate Visual Studio Projects" (docs/RSPROJ.md work package 5). This file is
       yours: it is never overwritten by a later run - edit it freely, or delete it and re-run the command
       to get a fresh default. -->
  <PropertyGroup>
    <CargoPackage>drive-app-storage</CargoPackage>
    <!-- The workspace's programs share most of their crates: build the whole workspace in one cargo run,
         so that a solution build compiles each shared crate once, with one feature set (docs/RSPROJ.md, "Cargo workspaces"). -->
    <CargoBuildScope>Workspace</CargoBuildScope>
  </PropertyGroup>

</Project>
