<Project Sdk="Kubuno.Rust.Sdk/1.1.0">

  <!-- Written by hand following "Kubuno: Generate Visual Studio Projects" (docs/RSPROJ.md work package 5). This file is
       yours: it is never overwritten by a later run - edit it freely, or delete it and re-run the command
       to get a fresh default. The crate belongs to the cross-OS workspace ..\Cargo.toml (desktop/common), found
       by the SDK from the manifests (CargoWorkspaceRoot); it has no dylib, so it builds at package scope. -->
  <PropertyGroup>
    <CargoPackage>kubuno-sync-engine</CargoPackage>
  </PropertyGroup>

</Project>
